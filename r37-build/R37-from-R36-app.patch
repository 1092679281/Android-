diff --git a/app/src/main/java/com/mcarplay/app/video/ProjectionFocus.kt b/app/src/main/java/com/mcarplay/app/video/ProjectionFocus.kt
new file mode 100644
index 0000000..19b5198
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/video/ProjectionFocus.kt
@@ -0,0 +1,75 @@
+package com.mcarplay.app.video
+
+import kotlin.math.abs
+
+internal enum class ProjectionDirection { UP, DOWN, LEFT, RIGHT }
+
+/** Bounds and action are derived from the same immutable layout used to draw the frame. */
+internal data class ProjectionFocusTarget(
+    val bounds: ProjectionRect,
+    val page: ProjectionPage? = null,
+    val action: DashboardAction? = null,
+)
+
+internal object ProjectionFocus {
+    private val swipePages = listOf(ProjectionPage.HOME, ProjectionPage.MUSIC, ProjectionPage.WIDGETS)
+
+    fun targets(layout: ProjectedDashboardLayout): List<ProjectionFocusTarget> =
+        if (!layout.shell || layout.fullContent) emptyList()
+        else (layout.dock + layout.tiles).map { (page, bounds) -> ProjectionFocusTarget(bounds, page = page) } +
+            layout.controls.map { (action, bounds) -> ProjectionFocusTarget(bounds, action = action) }
+
+    fun move(layout: ProjectedDashboardLayout, current: ProjectionFocusTarget?, direction: ProjectionDirection): ProjectionFocusTarget? {
+        val candidates = targets(layout)
+        if (current !in candidates) return candidates.firstOrNull { it.page == layout.page } ?: candidates.firstOrNull()
+        val origin = requireNotNull(current).bounds
+        val ox = origin.left + origin.right
+        val oy = origin.top + origin.bottom
+        var best: ProjectionFocusTarget? = null
+        var bestScore = Long.MAX_VALUE
+        for (target in candidates) {
+            val r = target.bounds
+            val dx = r.left + r.right - ox
+            val dy = r.top + r.bottom - oy
+            val forward = when (direction) {
+                ProjectionDirection.UP -> -dy
+                ProjectionDirection.DOWN -> dy
+                ProjectionDirection.LEFT -> -dx
+                ProjectionDirection.RIGHT -> dx
+            }
+            if (forward <= 0) continue
+            val cross = if (direction == ProjectionDirection.UP || direction == ProjectionDirection.DOWN) abs(dx) else abs(dy)
+            val score = forward.toLong() * forward + 4L * cross * cross
+            if (score < bestScore) {
+                best = target
+                bestScore = score
+            }
+        }
+        return best ?: current
+    }
+
+    /** Swipes are local-only; never reinterpret live video or a captured button. No wraparound. */
+    fun swipe(layout: ProjectedDashboardLayout, from: Pair<Int, Int>, to: Pair<Int, Int>): ProjectionPage? {
+        if (!layout.shell || layout.fullContent || layout.showsVideo) return null
+        if (!layout.workspace.contains(from.first, from.second) || !layout.workspace.contains(to.first, to.second)) return null
+        val dx = to.first - from.first
+        val dy = to.second - from.second
+        val threshold = maxOf(48, layout.height / 7)
+        if (abs(dx) < threshold || abs(dx) < 2 * abs(dy)) return null
+        val index = swipePages.indexOf(layout.page)
+        if (index < 0) return null
+        return swipePages.getOrNull(index + if (dx < 0) 1 else -1)
+    }
+}
+
+/** Unsupported secondary contacts cancel the entire gesture until every contact is released. */
+internal class ProjectionContactGate {
+    private var blocked = false
+
+    fun accepts(primaryDown: Boolean, secondaryDown: Boolean): Boolean {
+        if (secondaryDown) blocked = true
+        if (!blocked) return true
+        if (!primaryDown && !secondaryDown) blocked = false
+        return false
+    }
+}
