+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class ProjectionFocusTest {
+    private fun base() = ProjectedDashboardLayout(2400, 800, 1920, 1080, true, shell = true)
+
+    @Test
+    fun multiContactBlocksUntilAllPointersLift() {
+        val gate = ProjectionContactGate()
+        assertTrue(gate.accepts(true, false))
+        assertFalse(gate.accepts(true, true))
+        assertFalse(gate.accepts(false, true))
+        assertFalse(gate.accepts(true, false))
+        assertFalse(gate.accepts(false, false))
+        assertTrue(gate.accepts(true, false))
+        assertTrue(gate.accepts(false, false))
+        val random = Random(370)
+        var blocked = false
+        repeat(10000) {
+            val primary = random.nextBoolean()
+            val secondary = random.nextBoolean()
+            if (secondary) blocked = true
+            assertEquals(!blocked, gate.accepts(primary, secondary))
+            if (!primary && !secondary) blocked = false
+        }
+    }
+
+    @Test
+    fun dampedPressIsBoundedAndCompletesExactly() {
+        var previous = 0f
+        for (ms in -10L..200L) {
+            val next = ProjectionMotion.pressEase(ms)
+            assertTrue(next in previous..1f)
+            previous = next
+        }
+        assertEquals(0f, ProjectionMotion.pressEase(0L))
+        assertEquals(1f, ProjectionMotion.pressEase(ProjectionMotion.PRESS_MS))
+    }
+
+    @Test
+    fun focusRequiresMatchingWrittenFrameAndClearsOnPageChange() {
+        val l = base()
+        val state = ProjectionPageState<String>(l)
+        assertFalse(state.moveFocus(ProjectionDirection.DOWN))
+        state.submit(l, 1, "A")
+        state.markSent(1)
+        assertTrue(state.moveFocus(ProjectionDirection.DOWN))
+        val first = state.renderState().focus
+        assertNull(state.confirmedFocus())
+        state.submit(l, 2, "A", first)
+        assertTrue(state.moveFocus(ProjectionDirection.DOWN))
+        val second = state.renderState().focus
+        assertTrue(first != second)
+        state.markSent(2)
+        assertNull(state.confirmedFocus())
+        state.submit(l, 3, "B", second)
+        state.markSent(3)
+        assertEquals(second, state.confirmedFocus())
+        assertEquals("B", state.sentMedia())
+        assertTrue(state.select(ProjectionPage.HOME))
+        assertNull(state.confirmedFocus())
+        assertNull(state.renderState().focus)
+        assertFalse(state.moveFocus(ProjectionDirection.RIGHT))
+        val home = state.requested
+        state.submit(home, 4, null)
+        state.markSent(4)
+        assertTrue(state.moveFocus(ProjectionDirection.RIGHT))
+        state.invalidate()
+        assertNull(state.confirmedFocus())
+        assertNull(state.renderState().focus)
+    }
+
+    @Test
+    fun focusClearCannotBeRearmedByAnInFlightFrame() {
+        val l = base()
+        val state = ProjectionPageState<String>(l)
+        state.submit(l, 1, null)
+        state.markSent(1)
+        state.moveFocus(ProjectionDirection.DOWN)
+        state.submit(l, 2, null, state.renderState().focus)
+        assertTrue(state.clearFocus())
+        state.markSent(2)
+        assertNull(state.confirmedFocus())
+        assertNull(state.renderState().focus)
+    }
+
+    @Test
+    fun localSwipeDoesNotClickTilesOrStealMapGesture() {
+        val home = base().withPage(ProjectionPage.HOME)
+        val x = home.workspace.left + home.workspace.width / 2
+        val y = home.workspace.top + 5
+        val router = DashboardTouchRouter()
+        router.route(home, x, y, true, 1920, 1080)
+        router.route(home, x - 200, y, true, 1920, 1080)
+        val swipe = router.route(home, x - 300, y, false, 1920, 1080)
+        assertEquals(ProjectionPage.MUSIC, swipe.page)
+        assertNull(swipe.action)
+        assertNull(swipe.point)
+        router.route(home, x, y, true, 1920, 1080)
+        router.route(home, -1, y, true, 1920, 1080)
+        assertNull(router.route(home, x - 300, y, false, 1920, 1080).page)
+        router.route(home, x, y, true, 1920, 1080)
+        assertNull(router.route(home, x - 200, y + 150, false, 1920, 1080).page)
+        val tile = home.tiles.first().second
+        router.route(home, tile.left, tile.top, true, 1920, 1080)
+        assertNull(router.route(home, tile.right + 5, tile.top, false, 1920, 1080).page)
+        val nav = base().withPage(ProjectionPage.NAVIGATION)
+        val start = nav.video.left + nav.video.width / 2
+        val middle = nav.video.top + nav.video.height / 2
+        assertTrue(router.route(nav, start, middle, true, 1920, 1080).point != null)
+        val end = router.route(nav, start - 300, middle, false, 1920, 1080)
+        assertTrue(end.point != null)
+        assertNull(end.page)
+    }
+
+    @Test
+    fun geometryChangeCancelsCapturedSourceAndLocalTap() {
+        val l = base()
+        val router = DashboardTouchRouter()
+        router.route(l, l.video.left, l.video.top, true, 1920, 1080)
+        val home = l.withPage(ProjectionPage.HOME)
+        val cancel = router.route(home, home.workspace.left, home.workspace.top, false, 1920, 1080)
+        assertTrue(cancel.cancelSource)
+        assertNull(cancel.page)
+        val r = l.dock.first().second
+        router.route(l, r.left, r.top, true, 1920, 1080)
+        val local = router.route(home, r.left, r.top, false, 1920, 1080)
+        assertFalse(local.cancelSource)
+        assertNull(local.page)
+    }
+
+    @Test
+    fun randomFocusTargetsStayInCorrectDirectionAndNeverEnterVideo() {
+        val random = Random(37)
+        var checked = 0
+        repeat(3000) {
+            val w = random.nextInt(640, 2561)
+            val h = random.nextInt(360, 1081)
+            if (!ProjectedDashboardLayout.supports(w, h)) return@repeat
+            val l = ProjectedDashboardLayout(w, h, 1920, 1080, true, shell = true)
+                .withPage(ProjectionPage.entries.random(random))
+            val targets = ProjectionFocus.targets(l)
+            for (origin in targets) {
+                for (direction in ProjectionDirection.entries) {
+                    val next = requireNotNull(ProjectionFocus.move(l, origin, direction))
+                    assertTrue(next in targets)
+                    if (next != origin) {
+                        val a = origin.bounds
+                        val b = next.bounds
+                        val dx = b.left + b.right - a.left - a.right
+                        val dy = b.top + b.bottom - a.top - a.bottom
+                        assertTrue(when (direction) {
+                            ProjectionDirection.UP -> dy < 0
+                            ProjectionDirection.DOWN -> dy > 0
+                            ProjectionDirection.LEFT -> dx < 0
+                            ProjectionDirection.RIGHT -> dx > 0
+                        })
+                    }
+                    checked++
+                }
+            }
+        }
+        assertTrue(checked > 30000)
+        assertTrue(ProjectionFocus.targets(ProjectedDashboardLayout(1280, 720, 1920, 1080)).isEmpty())
+        println("Random directional focus checks: $checked")
+    }
+}
