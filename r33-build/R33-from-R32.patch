@@ -38,4 +38,11 @@ internal object LacrosseProjectionPolicy {
     /** Budget only the experimental local encoder; passthrough bitrates cannot be controlled here. */
-    fun bitrate(width: Int, height: Int, fps: Int): Int =
-        ProjectionEncoderPolicy.initialBitrate(width, height, fps).coerceAtMost(8_000_000)
+    fun bitrate(width: Int, height: Int, fps: Int): Int {
+        val extra = (fps - 30).coerceIn(0, 30)
+        val cap = 8_000_000L + 7_000_000L * extra / 30
+        val base = ProjectionEncoderPolicy.initialBitrate(width, height, 30).toLong()
+        return (base * (60 + extra) / 60).coerceAtMost(cap).toInt()
+    }
+
+    /** A rejected high-rate local encoder may retry once at 30 FPS. */
+    fun fallbackFps(fps: Int): Int? = if (fps > 30) 30 else null
 }
