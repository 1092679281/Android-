 }
+
+/** Extrapolate from the media provider's monotonic update timestamp, not the polling time. */
+internal object ProjectionMediaClock {
+    fun positionAt(
+        positionMs: Long,
+        durationMs: Long,
+        playing: Boolean,
+        speed: Float,
+        anchorMs: Long,
+        nowMs: Long,
+    ): Long {
+        if (positionMs < 0L || durationMs <= 0L) return -1L
+        val base = positionMs.coerceAtMost(durationMs)
+        if (!playing || !speed.isFinite() || anchorMs <= 0L || nowMs <= anchorMs) return base
+        // Double arithmetic avoids Long overflow even with corrupted provider timestamps or speed.
+        val delta = (nowMs - anchorMs).toDouble() * speed
+        return (base.toDouble() + delta).coerceIn(0.0, durationMs.toDouble()).toLong().coerceAtMost(durationMs)
+    }
+}
