+    private fun dispatchProjectedKey(controller: android.media.session.MediaController, key: Int): Boolean {
+        val state = controller.playbackState ?: return false
+        val actions = state.actions
+        val playing = state.state == PlaybackState.STATE_PLAYING
+        val controls = controller.transportControls
+        fun supports(action: Long) = actions and action != 0L
+        when (key) {
+            android.view.KeyEvent.KEYCODE_MEDIA_PREVIOUS -> {
+                if (!supports(PlaybackState.ACTION_SKIP_TO_PREVIOUS)) return false
+                controls.skipToPrevious()
+            }
+            android.view.KeyEvent.KEYCODE_MEDIA_NEXT -> {
+                if (!supports(PlaybackState.ACTION_SKIP_TO_NEXT)) return false
+                controls.skipToNext()
+            }
+            android.view.KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE -> {
+                if (playing && supports(PlaybackState.ACTION_PAUSE)) controls.pause()
+                else if (!playing && supports(PlaybackState.ACTION_PLAY)) controls.play()
+                else if (supports(PlaybackState.ACTION_PLAY_PAUSE)) {
+                    val down = controller.dispatchMediaButtonEvent(android.view.KeyEvent(android.view.KeyEvent.ACTION_DOWN, key))
+                    val up = controller.dispatchMediaButtonEvent(android.view.KeyEvent(android.view.KeyEvent.ACTION_UP, key))
+                    return down && up
+                } else return false
+            }
+            else -> return false
+        }
+        return true
+    }
