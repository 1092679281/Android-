--- /dev/null
+++ b/app/src/test/java/com/mcarplay/app/video/ProjectionMediaPolicyTest.kt
@@ -0,0 +1,111 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class ProjectionMediaPolicyTest {
+    private fun layout() = ProjectedDashboardLayout(2400, 800, 1920, 1080, true, shell = true)
+        .withPage(ProjectionPage.MUSIC)
+
+    @Test
+    fun unavailableControlsAreNotFocusTargets() {
+        val l = layout()
+        val random = Random(40)
+        repeat(10000) {
+            val capabilities = ProjectionMediaCapabilities(random.nextBoolean(), random.nextBoolean(), random.nextBoolean())
+            val targets = ProjectionFocus.targets(l, capabilities)
+            assertEquals(l.dock.size, targets.count { it.page != null })
+            assertEquals(DashboardAction.entries.filter(capabilities::allows).toSet(), targets.mapNotNull { it.action }.toSet())
+            for (origin in targets) {
+                for (direction in ProjectionDirection.entries) {
+                    val next = requireNotNull(ProjectionFocus.move(l, origin, direction, capabilities))
+                    assertTrue(next in targets)
+                }
+            }
+        }
+        println("Random capability/focus configurations: 10000")
+    }
+
+    @Test
+    fun disablingFocusedControlRequiresAConfirmedFrameAndClearsFocus() {
+        val pages = ProjectionPageState<String>(layout())
+        val onlyPlay = ProjectionMediaCapabilities(playPause = true)
+        pages.submit(pages.renderState(), 1L, "player", onlyPlay)
+        pages.confirmSent(1L)
+        repeat(6) { pages.moveFocus(ProjectionDirection.RIGHT) }
+        assertEquals(DashboardAction.PLAY_PAUSE, pages.renderState().focus?.action)
+        pages.submit(pages.renderState(), 2L, "player", onlyPlay)
+        pages.confirmSent(2L)
+        assertEquals(DashboardAction.PLAY_PAUSE, pages.confirmedFocus()?.action)
+        pages.submit(pages.renderState(), 3L, "player", ProjectionMediaCapabilities.NONE)
+        assertTrue(pages.sentCapabilities().playPause)
+        pages.confirmSent(3L)
+        assertFalse(pages.sentCapabilities().playPause)
+        assertNull(pages.confirmedFocus())
+        assertNull(pages.renderState().focus)
+        pages.invalidate()
+        assertEquals(ProjectionMediaCapabilities.NONE, pages.sentCapabilities())
+    }
+
+    @Test
+    fun capabilityChangesRefreshMediaRegionOnly() {
+        val key = DashboardVisualKey("12:00", "Wed", "Song", "Artist", true, true, 7, null)
+        assertEquals(DashboardDirty(false, true, false), key.copy(capabilities = ProjectionMediaCapabilities.ALL).changesFrom(key))
+        assertFalse(key.widgetsChangedFrom(key.copy(capabilities = ProjectionMediaCapabilities.ALL)))
+    }
+
+    @Test
+    fun albumAccentIgnoresTransparentAndNeutralPixels() {
+        assertNull(ProjectionAlbumPalette.accent(intArrayOf(0x00FF0000, 0xFF888888.toInt(), 0xFF000000.toInt())))
+        assertEquals(0xFF7F007F.toInt(), ProjectionAlbumPalette.accent(intArrayOf(0xFFFF0000.toInt(), 0xFF0000FF.toInt())))
+        assertEquals(0xFF123456.toInt(), ProjectionAlbumPalette.blend(0xFF123456.toInt(), null, false))
+    }
+
+    @Test
+    fun randomAlbumBlendStaysOpaqueAndBounded() {
+        val random = Random(400)
+        repeat(10000) {
+            val base = random.nextInt() or 0xFF000000.toInt()
+            val accent = random.nextInt() or 0xFF000000.toInt()
+            val night = random.nextBoolean()
+            val result = ProjectionAlbumPalette.blend(base, accent, night)
+            assertEquals(255, result ushr 24)
+            for (shift in listOf(0, 8, 16)) {
+                val a = (base ushr shift) and 255
+                val b = (accent ushr shift) and 255
+                val c = (result ushr shift) and 255
+                assertTrue(c in minOf(a, b)..maxOf(a, b))
+                assertTrue(kotlin.math.abs(c - a) <= if (night) 57 else 41)
+            }
+        }
+        println("Random bounded album palette checks: 10000")
+    }
+
+    @Test
+    fun unchangedProviderAnchorDoesNotRewindProgressOnPoll() {
+        assertEquals(5_000L, ProjectionMediaClock.positionAt(4_000L, 60_000L, true, 1f, 1_000L, 2_000L))
+        assertEquals(6_000L, ProjectionMediaClock.positionAt(4_000L, 60_000L, true, 1f, 1_000L, 3_000L))
+        assertEquals(4_000L, ProjectionMediaClock.positionAt(4_000L, 60_000L, false, 1f, 1_000L, 3_000L))
+        assertEquals(4_000L, ProjectionMediaClock.positionAt(4_000L, 60_000L, true, 1f, 4_000L, 3_000L))
+        assertEquals(-1L, ProjectionMediaClock.positionAt(-1L, 60_000L, true, 1f, 1_000L, 3_000L))
+    }
+
+    @Test
+    fun playbackClockSurvivesExtremeProviderData() {
+        val random = Random(401)
+        repeat(10000) {
+            val duration = random.nextLong(1L, Long.MAX_VALUE)
+            val base = random.nextLong(0L, Long.MAX_VALUE)
+            val now = random.nextLong(2L, Long.MAX_VALUE)
+            val speed = listOf(Float.NaN, Float.POSITIVE_INFINITY, Float.MAX_VALUE, -Float.MAX_VALUE, 1f, -1f, 0f).random(random)
+            val position = ProjectionMediaClock.positionAt(base, duration, true, speed, 1L, now)
+            assertTrue(position in 0L..duration)
+        }
+        println("Random playback clock edge cases: 10000")
+    }
+
+}
