+/** Capabilities of the *displayed* media session, independent of Android APIs. */
+internal data class ProjectionMediaCapabilities(
+    val previous: Boolean = false,
+    val playPause: Boolean = false,
+    val next: Boolean = false,
+) {
+    fun allows(action: DashboardAction): Boolean = when (action) {
+        DashboardAction.PREVIOUS -> previous
+        DashboardAction.PLAY_PAUSE -> playPause
+        DashboardAction.NEXT -> next
+    }
+
+    companion object {
+        val NONE = ProjectionMediaCapabilities()
+        val ALL = ProjectionMediaCapabilities(true, true, true)
+    }
+}
+
+/** Subtle, bounded album-derived wallpaper accent; no changes to video or foreground pixels. */
+internal object ProjectionAlbumPalette {
+    fun accent(samples: IntArray): Int? {
+        var r = 0L
+        var g = 0L
+        var b = 0L
+        var count = 0
+        for (pixel in samples) {
+            if (pixel ushr 24 < 192) continue
+            val red = (pixel ushr 16) and 255
+            val green = (pixel ushr 8) and 255
+            val blue = pixel and 255
+            if (maxOf(red, green, blue) - minOf(red, green, blue) < 20) continue
+            r += red
+            g += green
+            b += blue
+            count++
+        }
+        if (count == 0) return null
+        return (0xFF shl 24) or ((r / count).toInt() shl 16) or ((g / count).toInt() shl 8) or (b / count).toInt()
+    }
+
+    fun blend(base: Int, accent: Int?, night: Boolean): Int {
+        if (accent == null) return base
+        val weight = if (night) 22 else 16
+        fun channel(shift: Int): Int {
+            val a = (base ushr shift) and 255
+            val b = (accent ushr shift) and 255
+            return (a * (100 - weight) + b * weight + 50) / 100
+        }
+        return (0xFF shl 24) or (channel(16) shl 16) or (channel(8) shl 8) or channel(0)
+    }
+}
