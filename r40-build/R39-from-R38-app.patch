@@ -0,0 +1,104 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class ProjectionPresentationTest {
+    private fun layout(full: Boolean = false) =
+        ProjectedDashboardLayout(1920, 1080, 1920, 1080, true, fullContent = full, shell = true)
+
+    @Test
+    fun oldRenderSubmittedAfterInvalidationCannotReopenTouch() {
+        for (full in listOf(false, true)) {
+            val l = layout(full)
+            val pages = ProjectionPageState<String>(l)
+            val old = pages.renderState()
+            pages.submit(old, 1, "old")
+            pages.confirmSent(1)
+            assertEquals(l, pages.touchLayout())
+            pages.invalidate()
+            pages.submit(old, 2, "old")
+            assertEquals(ProjectionPageState.Confirmation.OBSOLETE, pages.confirmSent(2))
+            assertNull(pages.touchLayout())
+            assertNull(pages.sentMedia())
+            pages.submit(pages.renderState(), 3, "new")
+            assertEquals(ProjectionPageState.Confirmation.CURRENT, pages.confirmSent(3))
+            assertEquals(l, pages.touchLayout())
+            assertEquals("new", pages.sentMedia())
+            assertEquals(ProjectionPageState.Confirmation.OBSOLETE, pages.confirmSent(2))
+            assertEquals("new", pages.sentMedia())
+        }
+    }
+
+    @Test
+    fun pendingMetadataAcrossSeveralInvalidationsCannotRearm() {
+        val pages = ProjectionPageState<String>(layout())
+        repeat(5) { i ->
+            pages.submit(pages.renderState(), i.toLong(), "old")
+            pages.invalidate()
+        }
+        repeat(5) { i ->
+            assertEquals(ProjectionPageState.Confirmation.OBSOLETE, pages.confirmSent(i.toLong()))
+            assertNull(pages.touchLayout())
+        }
+        pages.submit(pages.renderState(), 5, "new")
+        assertEquals(ProjectionPageState.Confirmation.CURRENT, pages.confirmSent(5))
+        assertEquals("new", pages.sentMedia())
+    }
+
+    @Test
+    fun randomizedOldAndNewGenerationConfirmations() {
+        val random = Random(39)
+        val pages = ProjectionPageState<Long>(layout())
+        var pts = 0L
+        repeat(10000) {
+            val captured = pages.renderState()
+            val invalidated = random.nextBoolean()
+            if (invalidated) pages.invalidate()
+            pages.submit(captured, ++pts, pts)
+            val result = pages.confirmSent(pts)
+            if (invalidated) {
+                assertEquals(ProjectionPageState.Confirmation.OBSOLETE, result)
+                assertNull(pages.touchLayout())
+            } else {
+                assertEquals(ProjectionPageState.Confirmation.CURRENT, result)
+                assertEquals(pts, pages.sentMedia())
+            }
+        }
+        println("Random generation confirmations: 10000")
+    }
+
+    @Test
+    fun playbackTimestampsAreClampedAndUnknownDurationRemainsUnavailable() {
+        assertNull(ProjectionPlaybackTime.from(0, 0))
+        assertNull(ProjectionPlaybackTime.from(-1, 120_000))
+        val time = requireNotNull(ProjectionPlaybackTime.from(61_999, 3_661_999))
+        assertEquals("1:01", time.elapsed)
+        assertEquals("1:01:01", time.duration)
+        val clamped = requireNotNull(ProjectionPlaybackTime.from(Long.MAX_VALUE, 60_000))
+        assertEquals("1:00", clamped.elapsed)
+        assertEquals("1:00", clamped.duration)
+        val random = Random(390)
+        repeat(10000) {
+            val duration = random.nextLong(1L, Long.MAX_VALUE)
+            val position = random.nextLong(0L, Long.MAX_VALUE)
+            val label = requireNotNull(ProjectionPlaybackTime.from(position, duration))
+            assertTrue(label.elapsedSeconds in 0..label.durationSeconds)
+        }
+        println("Random playback time bounds: 10000")
+    }
+
+    @Test
+    fun elapsedLabelUpdatesOnlyTheProgressRegion() {
+        val time = ProjectionPlaybackTime.from(1_000, 100_000)
+        val key = DashboardVisualKey("12:00", "Wed", "Title", "Artist", true, true, 5, null, playbackTime = time)
+        val nextSecond = key.copy(playbackTime = ProjectionPlaybackTime.from(2_000, 100_000))
+        val sameSecond = key.copy(playbackTime = ProjectionPlaybackTime.from(1_999, 100_000))
+        assertEquals(DashboardDirty(false, false, true), nextSecond.changesFrom(key))
+        assertEquals(DashboardDirty(false, false, false), sameSecond.changesFrom(key))
+        assertEquals(DashboardDirty(false, false, true), key.copy(playbackTime = null).changesFrom(key))
+    }
+}
