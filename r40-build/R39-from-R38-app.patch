@@ -0,0 +1,24 @@
+package com.mcarplay.app.video
+
+/** Whole-second media timestamps. Unknown or invalid duration is never displayed as 0:00. */
+internal data class ProjectionPlaybackTime(val elapsedSeconds: Long, val durationSeconds: Long) {
+    val elapsed: String get() = format(elapsedSeconds)
+    val duration: String get() = format(durationSeconds)
+
+    companion object {
+        fun from(positionMs: Long, durationMs: Long): ProjectionPlaybackTime? {
+            if (durationMs <= 0L || positionMs < 0L) return null
+            return ProjectionPlaybackTime(positionMs.coerceAtMost(durationMs) / 1_000L, durationMs / 1_000L)
+        }
+
+        private fun format(seconds: Long): String {
+            val minutes = (seconds / 60) % 60
+            val secondText = (seconds % 60).toString().padStart(2, '0')
+            return if (seconds >= 3_600L) {
+                "${seconds / 3_600}:${minutes.toString().padStart(2, '0')}:$secondText"
+            } else {
+                "$minutes:$secondText"
+            }
+        }
+    }
+}
