+package com.mcarplay.app.iap2
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class Iap2AvailabilityProgressTest {
+    @Test
+    fun silentLinkDoesNotCountAsCarPlayStart() {
+        assertEquals(Iap2AvailabilityProgress.State.LINK_SILENT, Iap2AvailabilityProgress.classify(0L, false))
+    }
+
+    @Test
+    fun ackOrHeartbeatsAloneAreNotCarPlayStartEvidence() {
+        assertEquals(Iap2AvailabilityProgress.State.LINK_ACTIVITY_NO_START, Iap2AvailabilityProgress.classify(11L, false))
+    }
+
+    @Test
+    fun explicitStartSessionIsStrongEvidenceEvenWithNoOtherFrames() {
+        assertEquals(Iap2AvailabilityProgress.State.START_SESSION, Iap2AvailabilityProgress.classify(0L, true))
+    }
+}
--- a/app/src/test/java/com/mcarplay/app/iap2/Iap2OptionalMessagePolicyTest.kt
+++ b/app/src/test/java/com/mcarplay/app/iap2/Iap2OptionalMessagePolicyTest.kt
@@ -0,0 +1,44 @@
+package com.mcarplay.app.iap2
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class Iap2OptionalMessagePolicyTest {
+    private fun shouldSend(id: Int, accepts: Boolean?, model: String = "E2LB", manufacturer: String = "Saic General Motors") =
+        Iap2OptionalMessagePolicy.shouldSend(id, accepts, model, manufacturer)
+
+    @Test
+    fun e2lbExplicitReceiveListSkipsOptionalUndeclaredMessages() {
+        val allowed = setOf(0x6801, 0x4C01, 0x4C04, 0x5001, 0x4E09, 0x4E0A, 0x4E0B, 0x4E0C, 0x4300)
+        for (id in listOf(Iap2MessageIds.WIRELESS_CARPLAY_UPDATE, Iap2MessageIds.DEVICE_TRANSPORT_IDENTIFIER)) {
+            assertFalse(shouldSend(id, id in allowed))
+        }
+    }
+
+    @Test
+    fun unknownListAndDeclaredPositiveKeepLegacyBehavior() {
+        for (id in listOf(Iap2MessageIds.WIRELESS_CARPLAY_UPDATE, Iap2MessageIds.DEVICE_TRANSPORT_IDENTIFIER)) {
+            assertTrue(shouldSend(id, null))
+            assertTrue(shouldSend(id, true))
+        }
+    }
+
+    @Test
+    fun knownAudiWithIncompleteListsIsNotRegressed() {
+        for (id in listOf(Iap2MessageIds.WIRELESS_CARPLAY_UPDATE, Iap2MessageIds.DEVICE_TRANSPORT_IDENTIFIER)) {
+            assertTrue(shouldSend(id, false, "AUDI MMI", "DELPHI"))
+        }
+    }
+
+    @Test
+    fun otherGmModelsAreNotChangedWithoutEvidence() {
+        assertTrue(shouldSend(Iap2MessageIds.WIRELESS_CARPLAY_UPDATE, false, "A2LL"))
+    }
+
+    @Test
+    fun availabilityIsNeverSuppressedByOptionalFilter() {
+        assertTrue(shouldSend(Iap2MessageIds.CARPLAY_AVAILABILITY, false))
+        assertTrue(shouldSend(Iap2MessageIds.CARPLAY_AVAILABILITY, null))
+    }
+}
