+package com.mcarplay.app.iap2
+
+/**
+ * E2LB-only compatibility experiment. A receiver's advertised receive list is not
+ * always exhaustive: Audi MIB3 was observed to ACK undeclared messages. Do NOT
+ * generalize this filter to all receivers; keep their existing wire sequence.
+ */
+internal object Iap2OptionalMessagePolicy {
+    fun shouldSend(
+        messageId: Int,
+        accessoryAccepts: Boolean?,
+        model: String?,
+        manufacturer: String?,
+    ): Boolean {
+        val isE2lb = model.equals("E2LB", ignoreCase = true) && manufacturer.orEmpty().contains("general motors", ignoreCase = true)
+        if (!isE2lb || accessoryAccepts != false) return true
+        return messageId != Iap2MessageIds.WIRELESS_CARPLAY_UPDATE &&
+            messageId != Iap2MessageIds.DEVICE_TRANSPORT_IDENTIFIER
+    }
+}
