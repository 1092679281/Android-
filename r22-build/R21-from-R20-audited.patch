+package com.mcarplay.app.iap2
+
+/** Separates transport-level replies from a verified CarPlay-start signal. */
+internal object Iap2AvailabilityProgress {
+    enum class State { START_SESSION, LINK_SILENT, LINK_ACTIVITY_NO_START }
+
+    fun classify(
+        framesReceivedAfterAvailability: Long,
+        startSessionReceived: Boolean,
+    ): State =
+        when {
+            startSessionReceived -> State.START_SESSION
+            framesReceivedAfterAvailability == 0L -> State.LINK_SILENT
+            else -> State.LINK_ACTIVITY_NO_START
+        }
+}
