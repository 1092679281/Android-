+package com.mcarplay.app.iap2
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class E2lbAvailabilityBodyPolicyTest {
+    private val mac = "4C:92:D2:AB:CD:EF"
+
+    @Test fun defaultsOffAndDoesNotAffectAudiOrOtherGm() {
+        assertEquals(E2lbAvailabilityBodyPolicy.Shape.SINGLE_GROUP, E2lbAvailabilityBodyPolicy.select("E2LB", "Saic General Motors", mac, false))
+        assertEquals(E2lbAvailabilityBodyPolicy.Shape.SINGLE_GROUP, E2lbAvailabilityBodyPolicy.select("AUDI", "DELPHI", mac, true))
+        assertEquals(E2lbAvailabilityBodyPolicy.Shape.SINGLE_GROUP, E2lbAvailabilityBodyPolicy.select("A2LL", "General Motors", mac, true))
+        assertEquals(E2lbAvailabilityBodyPolicy.Shape.SINGLE_GROUP, E2lbAvailabilityBodyPolicy.select("E2LB", "General Motors", "02:00:00:00:00:00", true))
+    }
+
+    @Test fun dualGroupEncodesWiredAndLowercaseWirelessIdentifiers() {
+        val shape = E2lbAvailabilityBodyPolicy.select("E2LB", "Saic General Motors", mac, true)
+        assertEquals(E2lbAvailabilityBodyPolicy.Shape.DUAL_GROUP, shape)
+        val params = Iap2Csm.parseParams(E2lbAvailabilityBodyPolicy.body(shape, mac))
+        assertEquals(listOf(0, 1), params.map { it.id })
+        val group0 = Iap2Csm.parseParams(params[0].value)
+        val group1 = Iap2Csm.parseParams(params[1].value)
+        assertEquals("000081104C92D2ABCDEF0000", group0[1].value.toString(Charsets.UTF_8).trimEnd('\u0000'))
+        assertEquals("4c:92:d2:ab:cd:ef", group1[1].value.toString(Charsets.UTF_8).trimEnd('\u0000'))
+        assertTrue(group0[0].value.contentEquals(byteArrayOf(1)))
+    }
+}
