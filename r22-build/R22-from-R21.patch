+package com.mcarplay.app.iap2
+
+import java.util.Locale
+
+/**
+ * Opt-in, E2LB-only 0x4300 wire-shape experiment. No other receiver is changed.
+ * This is NOT known to make E2LB send 0x4301; tests are intentionally A/B.
+ */
+internal object E2lbAvailabilityBodyPolicy {
+    enum class Shape { SINGLE_GROUP, DUAL_GROUP }
+
+    fun select(
+        model: String?,
+        manufacturer: String?,
+        bluetoothMac: String,
+        experimentEnabled: Boolean,
+    ): Shape {
+        val isE2lb = model.equals("E2LB", ignoreCase = true) &&
+            manufacturer.orEmpty().contains("general motors", ignoreCase = true)
+        val macOk = Regex("[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}").matches(bluetoothMac) &&
+            !bluetoothMac.equals("02:00:00:00:00:00", ignoreCase = true)
+        return if (isE2lb && experimentEnabled && macOk) Shape.DUAL_GROUP else Shape.SINGLE_GROUP
+    }
+
+    fun body(shape: Shape, bluetoothMac: String): ByteArray = when (shape) {
+        Shape.SINGLE_GROUP -> Iap2Csm.group(1, Iap2Csm.u8(0, 1), Iap2Csm.string(1, bluetoothMac))
+        Shape.DUAL_GROUP -> {
+            val compact = bluetoothMac.replace(":", "").uppercase(Locale.ROOT)
+            val wiredId = "00008110${compact}0000"
+            Iap2Csm.group(0, Iap2Csm.u8(0, 1), Iap2Csm.string(1, wiredId)) +
+                Iap2Csm.group(1, Iap2Csm.u8(0, 1), Iap2Csm.string(1, bluetoothMac.lowercase(Locale.ROOT)))
+        }
+    }
+}
