 internal enum class DashboardAction { PREVIOUS, PLAY_PAUSE, NEXT }
+internal enum class ProjectionPage { DASHBOARD, HOME, NAVIGATION, MUSIC, WIDGETS }
+
+/** Track the local frame that was actually written to the video socket, not a receiver ACK. */
+internal class ProjectionPageState<T>(initial: ProjectedDashboardLayout) {
+    @Volatile var requested = initial
+        private set
+    private data class Frame<T>(val layout: ProjectedDashboardLayout, val media: T?)
+    private val frames = LinkedHashMap<Long, Frame<T>>()
+    private var sent: Frame<T>? = null
+    private var lastSentPts = Long.MIN_VALUE
+
+    @Synchronized fun select(page: ProjectionPage): Boolean {
+        if (requested.fullContent || requested.page == page || sent?.layout !== requested) return false
+        requested = requested.withPage(page)
+        return true
+    }
+
+    @Synchronized fun submit(layout: ProjectedDashboardLayout, ptsUs: Long, media: T?) {
+        frames[ptsUs] = Frame(layout, media)
+        while (frames.size > 64) frames.remove(frames.keys.first())
+    }
+
+    @Synchronized fun markSent(ptsUs: Long): Boolean {
+        if (ptsUs <= lastSentPts) return sent != null
+        lastSentPts = ptsUs
+        // Unknown or rewritten timestamps must not enable input against unconfirmed geometry.
+        sent = frames[ptsUs]
+        frames.entries.removeAll { it.key <= ptsUs }
+        return sent != null
+    }
+
+    @Synchronized fun invalidate() { sent = null; frames.clear() }
+    @Synchronized fun touchLayout(): ProjectedDashboardLayout? = sent?.layout?.takeIf { it === requested }
+    @Synchronized fun sentMedia(): T? = sent?.takeIf { it.layout === requested }?.media
+}
 
