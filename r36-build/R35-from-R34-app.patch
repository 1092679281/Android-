diff --git a/app/src/test/java/com/mcarplay/app/video/ProjectionShellTest.kt b/app/src/test/java/com/mcarplay/app/video/ProjectionShellTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/mcarplay/app/video/ProjectionShellTest.kt
@@ -0,0 +1,161 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class ProjectionShellTest {
+    private fun layout() = ProjectedDashboardLayout(2400, 800, 1920, 1080, true, shell = true)
+
+    @Test
+    fun onlyWrittenFramesUnlockPageInputAndMedia() {
+        val initial = layout()
+        val pages = ProjectionPageState<String>(initial)
+        assertNull(pages.touchLayout())
+        pages.submit(initial, 100, "A")
+        assertNull(pages.touchLayout())
+        pages.markSent(100)
+        assertEquals(initial, pages.touchLayout())
+        assertEquals("A", pages.sentMedia())
+        assertTrue(pages.select(ProjectionPage.MUSIC))
+        assertNull(pages.touchLayout())
+        assertNull(pages.sentMedia())
+        assertFalse(pages.select(ProjectionPage.HOME))
+        pages.submit(initial, 110, "A")
+        pages.markSent(110)
+        assertNull(pages.touchLayout())
+        val music = pages.requested
+        pages.submit(music, 120, "B")
+        pages.markSent(120)
+        assertEquals(music, pages.touchLayout())
+        assertEquals("B", pages.sentMedia())
+        pages.markSent(110)
+        assertEquals("B", pages.sentMedia())
+        pages.invalidate()
+        assertNull(pages.touchLayout())
+        assertNull(pages.sentMedia())
+        pages.submit(music, 130, "C")
+        pages.markSent(131)
+        assertNull(pages.touchLayout())
+        pages.submit(music, 140, "C")
+        pages.markSent(140)
+        assertEquals("C", pages.sentMedia())
+    }
+
+    @Test
+    fun metadataEvictionAndUnknownTimestampFailClosed() {
+        val l = layout()
+        val pages = ProjectionPageState<String>(l)
+        repeat(100) { pages.submit(l, it.toLong(), "player-$it") }
+        assertFalse(pages.markSent(0))
+        assertNull(pages.touchLayout())
+        assertTrue(pages.markSent(99))
+        assertEquals("player-99", pages.sentMedia())
+        pages.invalidate()
+        assertFalse(pages.markSent(100))
+        assertNull(pages.touchLayout())
+    }
+
+    @Test
+    fun homeAndDockActionsNeverLeakIntoSource() {
+        val home = layout().withPage(ProjectionPage.HOME)
+        assertFalse(home.showsVideo)
+        assertEquals(4, home.tiles.size)
+        for ((page, rect) in home.dock + home.tiles) {
+            val router = DashboardTouchRouter()
+            assertNull(router.route(home, rect.left, rect.top, true, 1920, 1080).point)
+            val up = router.route(home, rect.left, rect.top, false, 1920, 1080)
+            assertEquals(page, up.page)
+            assertNull(up.action)
+            assertNull(up.point)
+        }
+        val router = DashboardTouchRouter()
+        val tile = home.tiles.first().second
+        router.route(home, tile.left, tile.top, true, 1920, 1080)
+        router.route(home, -1, -1, true, 1920, 1080)
+        assertNull(router.route(home, tile.left, tile.top, false, 1920, 1080).page)
+    }
+
+    @Test
+    fun navigationAndMusicUseCorrectIndependentGeometry() {
+        val base = layout()
+        val nav = base.withPage(ProjectionPage.NAVIGATION)
+        val music = base.withPage(ProjectionPage.MUSIC)
+        assertTrue(nav.showsVideo)
+        assertTrue(nav.video.width >= base.video.width)
+        val mini = requireNotNull(nav.miniPanel)
+        assertEquals(3, nav.controls.size)
+        assertTrue(mini.left > nav.video.right)
+        assertTrue(nav.controls.all { it.second.left >= mini.left && it.second.right <= mini.right })
+        val narrow = ProjectedDashboardLayout(1280, 720, 1920, 1080, shell = true).withPage(ProjectionPage.NAVIGATION)
+        assertNull(narrow.miniPanel)
+        assertTrue(narrow.controls.isEmpty())
+        assertFalse(music.showsVideo)
+        assertEquals(3, music.controls.size)
+        assertTrue(requireNotNull(music.musicArt).right < music.panel.left)
+        assertNull(music.sourcePoint(0, 0, 1920, 1080))
+        val rect = music.controls[1].second
+        val router = DashboardTouchRouter()
+        router.route(music, rect.left, rect.top, true, 1920, 1080)
+        assertEquals(DashboardAction.PLAY_PAUSE, router.route(music, rect.left, rect.top, false, 1920, 1080).action)
+        val navRouter = DashboardTouchRouter()
+        assertEquals(0 to 0, navRouter.route(nav, nav.video.left, nav.video.top, true, 1920, 1080).point)
+        assertTrue(navRouter.reset())
+        assertNull(navRouter.route(nav, nav.video.left, nav.video.top, false, 1920, 1080).point)
+    }
+
+    @Test
+    fun fullContentRemainsLegacyAspectFit() {
+        val full = ProjectedDashboardLayout(1920, 1080, 1920, 1080, true, true, shell = true)
+        assertEquals(ProjectionRect(0, 0, 1920, 1080), full.video)
+        assertTrue(full.dock.isEmpty())
+        val pages = ProjectionPageState<String>(full)
+        pages.submit(full, 1, null)
+        pages.markSent(1)
+        assertFalse(pages.select(ProjectionPage.HOME))
+    }
+
+    @Test
+    fun randomizedPageBoundsAndHitTargets() {
+        val random = Random(35)
+        var configurations = 0
+        repeat(10000) {
+            val w = random.nextInt(640, 2561)
+            val h = random.nextInt(360, 1081)
+            if (!ProjectedDashboardLayout.supports(w, h)) return@repeat
+            val base = ProjectedDashboardLayout(w, h, random.nextInt(320, 3841), random.nextInt(180, 2161),
+                random.nextBoolean(), shell = true)
+            for (page in ProjectionPage.entries) {
+                val l = base.withPage(page)
+                val boxes = (l.dock + l.tiles).map { it.second }
+                assertTrue(boxes.all { it.left >= 0 && it.top >= 0 && it.right <= w && it.bottom <= h && it.width > 0 && it.height > 0 })
+                for (i in boxes.indices) for (j in i + 1 until boxes.size) {
+                    val a = boxes[i]; val b = boxes[j]
+                    assertTrue(a.right <= b.left || b.right <= a.left || a.bottom <= b.top || b.bottom <= a.top)
+                }
+                if (l.showsVideo) {
+                    assertTrue(l.video.left >= l.rail.right && l.video.right <= w && l.video.height > 0)
+                    assertEquals(0 to 0, l.sourcePoint(l.video.left, l.video.top, 1920, 1080))
+                }
+                l.miniPanel?.let { mini ->
+                    assertTrue(mini.left > l.video.right && mini.right <= w && mini.bottom <= h)
+                    assertTrue(l.controls.size == 3)
+                }
+                l.musicArt?.let { art -> assertTrue(art.right < l.panel.left && art.width > 0) }
+                configurations++
+            }
+        }
+        assertTrue(configurations > 30000)
+        println("Random valid page layouts: $configurations")
+    }
+
+    @Test
+    fun mediaIdentityTriggersDirtyUpdateEvenWithIdenticalTitles() {
+        val a = DashboardVisualKey("12:00", "Wed", "song", "artist", true, true, 0, null, "A")
+        assertTrue(a.copy(mediaIdentity = "B").changesFrom(a).panel)
+        assertFalse(a.copy().changesFrom(a).any)
+    }
+}
