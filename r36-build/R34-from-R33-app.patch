diff --git a/app/src/test/java/com/mcarplay/app/video/R34RuntimePolicyTest.kt b/app/src/test/java/com/mcarplay/app/video/R34RuntimePolicyTest.kt
new file mode 100644
index 0000000..25bbb2e
--- /dev/null
+++ b/app/src/test/java/com/mcarplay/app/video/R34RuntimePolicyTest.kt
@@ -0,0 +1,124 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.Socket
+
+class R34RuntimePolicyTest {
+    @Test
+    fun phaseAligned60HzDoesNotDriftOnMillisecondHandler() {
+        val pacer = ProjectionFramePacer(60)
+        var count = 0
+        for (ms in 0L until 60_000L) {
+            pacer.sourceArrived()
+            if (pacer.delayMs(ms * 1_000_000) == 0L) {
+                pacer.rendered(ms * 1_000_000)
+                count++
+            }
+        }
+        assertEquals(3600, count)
+        pacer.updateRate(30)
+        pacer.rendered(60_000_000_000L)
+        assertEquals(34L, pacer.delayMs(60_000_000_000L))
+    }
+
+    @Test
+    fun sustainedCongestionAndCoolingRecoverInStages() {
+        val policy = ProjectionRuntimePolicy(60)
+        policy.observe(0, 100_000_000, 0)
+        assertEquals(45, policy.fps())
+        policy.observe(1600, 100_000_000, 0)
+        assertEquals(24, policy.fps())
+        for (t in 2000L..44000L step 200) policy.observe(t, 1_000_000, 0)
+        assertEquals(60, policy.fps())
+        policy.updateThermal(3, 45000)
+        assertEquals(30, policy.fps())
+        for (t in 46000L..55000L step 1000) policy.updateThermal(0, t)
+        assertEquals(30, policy.fps())
+        policy.updateThermal(0, 56000)
+        assertEquals(45, policy.fps())
+        policy.updateThermal(-1, 57000)
+        policy.updateThermal(0, 100000)
+        assertEquals(45, policy.fps())
+    }
+
+    @Test
+    fun slowGpuAndIdleTimeAreNotMistakenForHealthyVideo() {
+        val policy = ProjectionRuntimePolicy(60)
+        for (t in 0L..400L step 200) {
+            policy.recordRender(t, 25_000_000)
+            policy.observe(t, 1_000_000, 0)
+        }
+        assertEquals(50, policy.fps())
+        policy.observe(2000, 1_000_000, 0)
+        policy.observe(40000, 1_000_000, 0)
+        assertEquals(50, policy.fps())
+    }
+
+    @Test
+    fun queueExpiryInvalidatesOldAccessUnitsAndRequiresIdr() {
+        val q = FreshVideoQueue(2)
+        fun frame(key: Boolean) = ExternalVideoFrame(byteArrayOf(1), key, 0)
+        assertTrue(q.offer(frame(true), 0).accepted)
+        assertTrue(q.offer(frame(false), 1).accepted)
+        val old = requireNotNull(q.poll(0))
+        assertTrue(q.offer(frame(false), 2).accepted)
+        assertFalse(q.offer(frame(false), 3).accepted)
+        assertFalse(q.admit(old, 4))
+        assertFalse(q.offer(frame(false), 5).accepted)
+        assertTrue(q.offer(frame(true), 6).accepted)
+        assertTrue(q.admit(requireNotNull(q.poll(0)), 6))
+        assertTrue(q.offer(frame(false), 10).accepted)
+        assertFalse(q.admit(requireNotNull(q.poll(0)), 300_000_010))
+        assertFalse(q.offer(frame(false), 300_000_011).accepted)
+        assertTrue(q.offer(frame(true), 300_000_012).accepted)
+        q.close()
+        assertFalse(q.offer(frame(true), 300_000_013).accepted)
+    }
+
+    @Test
+    fun bitrateCeilingDoesNotClaimUnappliedHardwareChanges() {
+        val abr = VideoEncoderAbr(5_000_000, 15_000_000, 15_000_000)
+        val decision = requireNotNull(abr.onFrameWritten(8000, 1_000_000, 1000, 8_000_000))
+        assertEquals(8_000_000, decision.bitrateBps)
+        assertEquals(15_000_000, abr.currentBitrate)
+        assertTrue(abr.onApplied(decision, 1000))
+        repeat(400) { assertNull(abr.onFrameWritten(8000, 1_000_000, 3000L + it * 20, 8_000_000)) }
+        assertEquals(8_750_000, abr.onFrameWritten(8000, 1_000_000, 12000, 15_000_000)?.bitrateBps)
+    }
+
+    @Test
+    fun fullContentPreservesAspectAndTouchCoordinates() {
+        val full = ProjectedDashboardLayout(1920, 1080, 1920, 1080, true, true)
+        assertEquals(ProjectionRect(0, 0, 1920, 1080), full.video)
+        assertTrue(full.controls.isEmpty())
+        assertEquals(1919 to 1079, full.sourcePoint(1919, 1079, 1920, 1080))
+        val wide = ProjectedDashboardLayout(2400, 800, 1920, 1080, true, true)
+        assertEquals(800, wide.video.height)
+        assertTrue(wide.video.left > 0)
+        assertNull(DashboardTouchRouter().route(wide, 0, 400, true, 1920, 1080).point)
+    }
+
+    @Test
+    fun watchdogCannotCloseTheWrongSocketOrCompletedWrite() {
+        Socket().use { a ->
+            Socket().use { b ->
+                val deadline = VideoWriteDeadline(100)
+                val first = deadline.begin(a, 0)
+                assertFalse(deadline.expire(b, 200))
+                assertFalse(deadline.expire(a, 99))
+                deadline.finish(first)
+                assertFalse(deadline.expire(a, 200))
+                val next = deadline.begin(a, 200)
+                deadline.finish(first)
+                assertTrue(deadline.expire(a, 300))
+                assertTrue(a.isClosed)
+                assertFalse(b.isClosed)
+                deadline.finish(next)
+            }
+        }
+    }
+}
