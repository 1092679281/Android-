diff --git a/app/src/main/java/com/mcarplay/app/video/FreshVideoQueue.kt b/app/src/main/java/com/mcarplay/app/video/FreshVideoQueue.kt
new file mode 100644
index 0000000..5bc2a9e
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/video/FreshVideoQueue.kt
@@ -0,0 +1,54 @@
+package com.mcarplay.app.video
+
+import java.util.concurrent.LinkedBlockingQueue
+import java.util.concurrent.TimeUnit
+
+/** One consumer, serialized producers. Discontinuity invalidates the whole old reference chain. */
+internal class FreshVideoQueue(capacity: Int) {
+    data class Entry(val frame: ExternalVideoFrame, val queuedAtNs: Long, val generation: Long)
+    data class Offer(val accepted: Boolean, val gap: Boolean)
+    private val queue = LinkedBlockingQueue<Entry>(capacity)
+    private val lock = Any()
+    private var generation = 0L
+    private var awaitingIdr = false
+    private var closed = false
+    val size: Int get() = queue.size
+
+    fun offer(frame: ExternalVideoFrame, nowNs: Long): Offer = synchronized(lock) {
+        if (closed) return@synchronized Offer(false, false)
+        var gap = false
+        if (queue.peek()?.let { VideoQueueBudget.expired(it.queuedAtNs, nowNs) } == true || queue.remainingCapacity() == 0) {
+            invalidateLocked()
+            gap = true
+        }
+        if (awaitingIdr && !frame.keyFrame) return@synchronized Offer(false, true)
+        awaitingIdr = false
+        check(queue.offer(Entry(frame, nowNs, generation)))
+        Offer(true, gap)
+    }
+
+    fun poll(timeoutMs: Long): Entry? = queue.poll(timeoutMs, TimeUnit.MILLISECONDS)
+
+    /** Called immediately before processing, with the actual monotonic clock. */
+    fun admit(entry: Entry, nowNs: Long): Boolean = synchronized(lock) {
+        if (closed || entry.generation != generation) return@synchronized false
+        if (VideoQueueBudget.expired(entry.queuedAtNs, nowNs)) {
+            invalidateLocked()
+            return@synchronized false
+        }
+        true
+    }
+
+    fun clear() = synchronized(lock) { invalidateLocked() }
+
+    fun close() = synchronized(lock) {
+        closed = true
+        invalidateLocked()
+    }
+
+    private fun invalidateLocked() {
+        generation++
+        queue.clear()
+        awaitingIdr = true
+    }
+}
