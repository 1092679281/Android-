diff --git a/app/src/main/java/com/mcarplay/app/video/ProjectionRuntimePolicy.kt b/app/src/main/java/com/mcarplay/app/video/ProjectionRuntimePolicy.kt
new file mode 100644
index 0000000..d3a259e
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/video/ProjectionRuntimePolicy.kt
@@ -0,0 +1,105 @@
+package com.mcarplay.app.video
+
+/** Session-local GPU output budget. Never drops encoded reference frames to change FPS. */
+internal class ProjectionRuntimePolicy(private val maximumFps: Int) {
+    private val rates = (listOf(maximumFps, 50, 45, 30, 24).filter { it in 1..maximumFps }.distinct().sortedDescending())
+    private var networkIndex = 0
+    private var thermal = 0
+    private var thermalCap = maximumFps
+    private var coolSince: Long? = null
+    private var lastThermalAt: Long? = null
+    private var lastRenderAt: Long? = null
+    private var lastRenderDurationNs = 0L
+    private var lastBadAt: Long? = null
+    private var lastStepAt: Long? = null
+    private var healthySince: Long? = null
+    private var badCount = 0
+    private var lastSampleAt: Long? = null
+
+    init { require(maximumFps in 1..120) }
+
+    @Synchronized
+    fun updateThermal(status: Int, nowMs: Long) {
+        if (status !in 0..6) {
+            coolSince = null
+            lastThermalAt = null
+            return
+        }
+        if (lastThermalAt?.let { nowMs - it !in 0..2_500L } == true) coolSince = null
+        lastThermalAt = nowMs
+        thermal = status
+        val cap = minOf(maximumFps, when (status) {
+            0, 1 -> maximumFps
+            2 -> 45
+            3 -> 30
+            else -> 24
+        })
+        if (cap < thermalCap) {
+            thermalCap = cap
+            coolSince = null
+        } else if (cap > thermalCap) {
+            val since = coolSince ?: nowMs.also { coolSince = it }
+            if (nowMs - since >= 10_000) {
+                thermalCap = rates.filter { it > thermalCap && it <= cap }.minOrNull() ?: cap
+                coolSince = nowMs
+            }
+        } else coolSince = null
+    }
+
+    @Synchronized
+    fun recordRender(nowMs: Long, durationNs: Long) {
+        lastRenderAt = nowMs
+        lastRenderDurationNs = durationNs.coerceAtLeast(0L)
+    }
+
+    @Synchronized
+    fun observe(nowMs: Long, writeNs: Long, queueMs: Long) {
+        val renderRecent = lastRenderAt?.let { nowMs - it in 0..1_000L } == true
+        val renderBudget = 1_000_000_000L / minOf(rates[networkIndex], thermalCap)
+        val renderSlow = renderRecent && lastRenderDurationNs >= renderBudget
+        val bad = writeNs >= 12_000_000L || queueMs >= 120 || renderSlow
+        val severe = writeNs >= 80_000_000L || queueMs >= 250 ||
+            (renderRecent && lastRenderDurationNs >= 80_000_000L)
+        if (bad) {
+            healthySince = null
+            lastBadAt = nowMs
+        }
+        val sample = lastSampleAt
+        if (sample != null && nowMs - sample in 0 until 200) return
+        if (sample != null && nowMs - sample !in 0..1_500L) {
+            healthySince = null
+            badCount = 0
+        }
+        lastSampleAt = nowMs
+        if (bad) {
+            badCount++
+            val canStep = lastStepAt?.let { nowMs - it >= 1_500 } ?: true
+            if ((severe || badCount >= 3) && canStep) {
+                networkIndex = (networkIndex + if (severe) 2 else 1).coerceAtMost(rates.lastIndex)
+                lastStepAt = nowMs
+                badCount = 0
+            }
+        } else {
+            badCount = 0
+            val healthy = writeNs < 4_000_000L && queueMs < 60 && thermal < 2 &&
+                (!renderRecent || lastRenderDurationNs < renderBudget * 3 / 4)
+            if (!healthy) {
+                healthySince = null
+                return
+            }
+            if (healthySince == null) healthySince = nowMs
+            if (nowMs - requireNotNull(healthySince) >= 10_000 &&
+                (lastBadAt?.let { nowMs - it >= 10_000 } ?: true)
+            ) {
+                networkIndex = (networkIndex - 1).coerceAtLeast(0)
+                lastStepAt = nowMs
+                healthySince = nowMs
+            }
+        }
+    }
+
+    @Synchronized
+    fun fps(): Int {
+        return minOf(rates[networkIndex], thermalCap)
+    }
+}
