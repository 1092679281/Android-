diff --git a/app/src/main/java/com/mcarplay/app/video/VideoWriteDeadline.kt b/app/src/main/java/com/mcarplay/app/video/VideoWriteDeadline.kt
new file mode 100644
index 0000000..d113841
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/video/VideoWriteDeadline.kt
@@ -0,0 +1,29 @@
+package com.mcarplay.app.video
+
+import java.net.Socket
+import java.util.concurrent.atomic.AtomicReference
+
+/** Atomic write ownership. A watchdog may retire only the exact in-flight packet on its own socket. */
+internal class VideoWriteDeadline(private val timeoutNs: Long = 5_000_000_000L) {
+    class Ticket(val socket: Socket, val startedNs: Long)
+    private val active = AtomicReference<Ticket?>()
+
+    fun begin(socket: Socket, nowNs: Long): Ticket {
+        val ticket = Ticket(socket, nowNs)
+        check(active.compareAndSet(null, ticket)) { "concurrent video write" }
+        return ticket
+    }
+
+    fun finish(ticket: Ticket) {
+        active.compareAndSet(ticket, null)
+    }
+
+    fun expire(socket: Socket, nowNs: Long): Boolean {
+        val ticket = active.get() ?: return false
+        if (ticket.socket !== socket || nowNs - ticket.startedNs < timeoutNs) return false
+        // Close the exact socket immediately on success; never resume a partial encrypted packet.
+        if (!active.compareAndSet(ticket, null)) return false
+        socket.close()
+        return true
+    }
+}
