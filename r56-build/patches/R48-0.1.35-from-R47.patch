--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/airplay/ReceiverTrustPolicy.kt
@@ -0,0 +1,17 @@
+package com.mcarplay.app.airplay
+
+import java.io.IOException
+
+/** 身份信任链不完整或验证失败：不能通过重试/明文降级绕过。 */
+internal class UntrustedReceiverIdentityException(message: String) : IOException(message)
+
+/** pair-verify 必须持有已配对或经 pair-setup M6 验证的接收端静态 Ed25519 公钥。 */
+internal fun requireTrustedReceiverStaticPublicKey(key: ByteArray?): ByteArray {
+    if (key == null) {
+        throw UntrustedReceiverIdentityException("pair-verify: 缺少可信接收端静态公钥；拒绝跳过身份签名验证")
+    }
+    if (key.size != 32) {
+        throw UntrustedReceiverIdentityException("pair-verify: 接收端静态 Ed25519 公钥长度无效")
+    }
+    return key.copyOf()
+}
