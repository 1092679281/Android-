@@ -0,0 +1,11 @@
+package com.mcarplay.app.bt
+
+/** 只有产生视频帧的当前诊断轮次才能清除该接收端的连续失败熔断。 */
+internal fun isCurrentHealthyReconnectAttempt(
+    attempt: String?,
+    currentAttempt: String?,
+    videoFrames: Long,
+): Boolean =
+    !attempt.isNullOrBlank() &&
+        attempt == currentAttempt &&
+        videoFrames > 0L
