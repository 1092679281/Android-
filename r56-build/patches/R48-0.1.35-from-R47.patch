+package com.mcarplay.app.bt
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ReconnectAttemptPolicyTest {
+    @Test
+    fun currentAttemptWithVideoFramesCanClearFailureHistory() {
+        assertTrue(isCurrentHealthyReconnectAttempt("attempt-2", "attempt-2", 1L))
+    }
+
+    @Test
+    fun lateVideoFromRetiredAttemptCannotClearNewAttemptFailures() {
+        assertFalse(isCurrentHealthyReconnectAttempt("attempt-1", "attempt-2", 1L))
+    }
+
+    @Test
+    fun noFramesCannotClearFailureHistory() {
+        assertFalse(isCurrentHealthyReconnectAttempt("attempt-2", "attempt-2", 0L))
+    }
+
+    @Test
+    fun missingAttemptCannotClearFailureHistory() {
+        assertFalse(isCurrentHealthyReconnectAttempt(null, "attempt-2", 1L))
+        assertFalse(isCurrentHealthyReconnectAttempt("", "attempt-2", 1L))
+    }
+}
