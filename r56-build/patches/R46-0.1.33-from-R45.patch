+        assertEquals(Blocker.IAP2_LINK, progress()!!.blocker)
+        assertTrue(ConnectionProgress.bluetoothEndedDuringStartup(timeline.snapshot()!!))
+        assertTrue(timeline.snapshot()!!.summary().contains("蓝牙曾成功建立"))
+    }
+
+    @Test
+    fun threeStartupFailuresDoNotBecomeMissingBluetooth() {
+        repeat(3) {
+            val id = timeline.begin("receiver")
+            timeline.stage(id, ConnectionStage.BLUETOOTH)
+            assertEquals(Blocker.BT_LINK, progress()!!.blocker)
+            timeline.milestone(id, M.RFCOMM_CONNECTED)
+            timeline.milestone(id, M.BT_LINK)
+            timeline.milestone(id, M.IAP2_IDENTIFIED)
+            timeline.milestone(id, M.IAP2_AUTH_SIGNAL_UNVERIFIED)
+            assertEquals(Blocker.WIFI_INFO, progress()!!.blocker)
+            timeline.milestone(id, M.CARPLAY_AVAILABILITY_SUBMITTED)
+            timeline.finish(id, DiagnosticCode.BT_LINK_CLOSED, true)
+            val snapshot = timeline.snapshot()!!
+            assertEquals(Blocker.CARPLAY_START, progress()!!.blocker)
+            assertTrue(ConnectionProgress.bluetoothEndedDuringStartup(snapshot))
+            assertFalse(M.IAP2_AUTHENTICATED in snapshot.milestones)
+            assertFalse(M.WIFI_CREDENTIALS in snapshot.milestones)
+        }
+    }
+
+    @Test
+    fun lateMilestoneCannotMarkNewAttempt() {
+        val old = timeline.begin("old")
+        val fresh = timeline.begin("fresh")
+        timeline.stage(fresh, ConnectionStage.BLUETOOTH)
+        timeline.milestone(old, M.RFCOMM_CONNECTED)
+        timeline.milestone(old, M.CARPLAY_AVAILABILITY_SUBMITTED)
+        assertEquals(Blocker.BT_LINK, progress()!!.blocker)
+        assertFalse(ConnectionProgress.bluetoothWasEstablished(timeline.snapshot()!!))
+    }
+
+    @Test
+    fun wifiFailureRemainsWifiFailure() {
+        val id = timeline.begin("receiver")
+        timeline.milestone(id, M.BT_LINK)
+        timeline.stage(id, ConnectionStage.WIFI)
+        timeline.finish(id, DiagnosticCode.WIFI_JOIN_FAILED, true)
+        assertEquals(Blocker.WIFI_JOIN, progress()!!.blocker)
+        assertFalse(ConnectionProgress.bluetoothEndedDuringStartup(timeline.snapshot()!!))
+    }
 }
