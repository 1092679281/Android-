+package com.mcarplay.app.compat
+
+import com.mcarplay.app.iap2.ReceiverProfile
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ReceiverFingerprintTest {
+    private val signals =
+        ReceiverProfile.Signals(
+            model = "E2LB",
+            manufacturer = "General Motors",
+            firmwareVersion = "1.2.3",
+            srcvers = "480.7.4",
+            features = 1L,
+            sendIds = setOf(0x4301, 0x5703),
+            receiveIds = setOf(0x4300, 0x5702),
+            externalAccessoryProtocols = setOf("com.apple.carplay"),
+        )
+
+    @Test
+    fun missingOrMalformedBindingCannotCreatePersistentFallbackFingerprint() {
+        assertNull(ReceiverFingerprint.e2lbAvailabilityFingerprint(null, signals))
+        assertNull(ReceiverFingerprint.e2lbAvailabilityFingerprint("", signals))
+        assertNull(ReceiverFingerprint.e2lbAvailabilityFingerprint("02:11:22:33:44:55", signals))
+        assertNull(ReceiverFingerprint.e2lbAvailabilityFingerprint("a".repeat(63), signals))
+        assertNull(ReceiverFingerprint.e2lbAvailabilityFingerprint("g".repeat(64), signals))
+    }
+
+    @Test
+    fun missingBindingDoesNotRecreateTheLegacySharedFingerprint() {
+        val legacyKey = "e2lb4300_" + ReceiverFingerprint.digest(listOf("") + ReceiverFingerprint.identity(signals))
+        assertTrue(ReceiverFingerprint.isE2lbAvailabilityFingerprint(legacyKey))
+        assertNull(ReceiverFingerprint.e2lbAvailabilityFingerprint(null, signals))
+    }
+
+    @Test
+    fun stablePrivateBindingProducesValidDeterministicFingerprint() {
+        val binding = "a".repeat(64)
+        val first = ReceiverFingerprint.e2lbAvailabilityFingerprint(binding, signals)
+        val second = ReceiverFingerprint.e2lbAvailabilityFingerprint(binding, signals)
+        assertNotNull(first)
+        assertEquals(first, second)
+        assertTrue(ReceiverFingerprint.isE2lbAvailabilityFingerprint(first))
+    }
+
+    @Test
+    fun differentReceiverBindingsNeverShareFallbackFingerprint() {
+        val first = ReceiverFingerprint.e2lbAvailabilityFingerprint("a".repeat(64), signals)
+        val second = ReceiverFingerprint.e2lbAvailabilityFingerprint("b".repeat(64), signals)
+        assertNotNull(first)
+        assertNotNull(second)
+        assertFalse(first == second)
+    }
+
+    @Test
+    fun fingerprintValidatorRejectsRawAddressAndMalformedKeys() {
+        assertFalse(ReceiverFingerprint.isE2lbAvailabilityFingerprint(null))
+        assertFalse(ReceiverFingerprint.isE2lbAvailabilityFingerprint(""))
+        assertFalse(ReceiverFingerprint.isE2lbAvailabilityFingerprint("e2lb4300_" + "a".repeat(63)))
+        assertFalse(ReceiverFingerprint.isE2lbAvailabilityFingerprint("e2lb4300_" + "g".repeat(64)))
+        assertFalse(ReceiverFingerprint.isE2lbAvailabilityFingerprint("e2lb4300_02:11:22:33:44:55"))
+    }
+}
