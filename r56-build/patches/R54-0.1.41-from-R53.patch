+package com.mcarplay.app.iap2
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class MfiParameterEvidenceTest {
+    @Test
+    fun acceptsOneNonEmptyExpectedParameter() {
+        val result = MfiParameterEvidence.inspectNonEmptyParameter(Iap2Csm.param(0, byteArrayOf(1, 2, 3)), 0)
+        assertTrue(result.valid)
+        assertEquals(3, result.valueBytes)
+        assertEquals(null, result.reason)
+    }
+
+    @Test
+    fun acceptsOtherWellFormedParametersAroundExpectedParameter() {
+        val body = Iap2Csm.param(4, byteArrayOf(9)) + Iap2Csm.param(0, byteArrayOf(1, 2)) + Iap2Csm.param(7, byteArrayOf(8))
+        val result = MfiParameterEvidence.inspectNonEmptyParameter(body, 0)
+        assertTrue(result.valid)
+        assertEquals(2, result.valueBytes)
+    }
+
+    @Test
+    fun rejectsEmptyBodyAndMissingExpectedParameter() {
+        assertReason(byteArrayOf(), "empty_body")
+        assertReason(Iap2Csm.param(1, byteArrayOf(1)), "missing_expected_parameter")
+    }
+
+    @Test
+    fun rejectsEmptyExpectedParameter() {
+        assertReason(Iap2Csm.param(0, byteArrayOf()), "empty_expected_parameter")
+    }
+
+    @Test
+    fun rejectsTruncatedHeaderAndValue() {
+        assertReason(byteArrayOf(0, 4, 0), "truncated_parameter_header")
+        assertReason(byteArrayOf(0, 6, 0, 0, 1), "truncated_parameter_value")
+    }
+
+    @Test
+    fun rejectsInvalidParameterLength() {
+        assertReason(byteArrayOf(0, 3, 0, 0), "invalid_parameter_length")
+    }
+
+    @Test
+    fun rejectsDuplicateExpectedParameter() {
+        assertReason(Iap2Csm.param(0, byteArrayOf(1)) + Iap2Csm.param(0, byteArrayOf(2)), "duplicate_expected_parameter")
+    }
+
+    @Test
+    fun rejectsInvalidExpectedParameterId() {
+        val result = MfiParameterEvidence.inspectNonEmptyParameter(Iap2Csm.param(0, byteArrayOf(1)), 0x10000)
+        assertFalse(result.valid)
+        assertEquals("invalid_expected_parameter", result.reason)
+    }
+
+    @Test
+    fun randomParameterStreamsNeverThrow() {
+        val random = Random(0xAA03)
+        repeat(5_000) {
+            val body = ByteArray(random.nextInt(0, 96)) { random.nextInt(0, 256).toByte() }
+            MfiParameterEvidence.inspectNonEmptyParameter(body, 0)
+        }
+    }
+
+    private fun assertReason(
+        body: ByteArray,
+        expected: String,
+    ) {
+        val result = MfiParameterEvidence.inspectNonEmptyParameter(body, 0)
+        assertFalse(result.valid)
+        assertEquals(expected, result.reason)
+    }
+}
