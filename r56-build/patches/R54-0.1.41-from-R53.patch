+package com.mcarplay.app.iap2
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Test
+import kotlin.random.Random
+
+class Iap2SynchronizationPayloadTest {
+    private fun payload(
+        maxOutgoing: Int = 4,
+        maxLength: Int = 0xFFFF,
+        sessions: List<Iap2LinkEngine.SessionDescriptor> = validSessions(),
+    ) =
+        Iap2LinkEngine.SynchronizationPayload(
+            maxOutgoing = maxOutgoing,
+            maxLength = maxLength,
+            retransmissionTimeoutMillis = 4_000,
+            acknowledgementTimeoutMillis = 500,
+            maxRetransmissions = 4,
+            maxAcknowledgements = 3,
+            sessions = sessions,
+        )
+
+    @Test
+    fun validSynchronizationPayloadRoundTrips() {
+        val expected = payload()
+        assertEquals(expected, Iap2LinkEngine.SynchronizationPayload.decode(expected.encode()))
+    }
+
+    @Test
+    fun partialTrailingSessionDescriptorIsRejected() {
+        assertNull(Iap2LinkEngine.SynchronizationPayload.decode(payload().encode() + byteArrayOf(1)))
+        assertNull(Iap2LinkEngine.SynchronizationPayload.decode(payload().encode() + byteArrayOf(1, 2)))
+    }
+
+    @Test
+    fun missingControlSessionIsRejected() {
+        assertNull(
+            Iap2LinkEngine.SynchronizationPayload.decode(
+                payload(sessions = listOf(Iap2LinkEngine.SessionDescriptor(2, 2, 1))).encode(),
+            ),
+        )
+    }
+
+    @Test
+    fun duplicateSessionIdsAreRejected() {
+        assertNull(
+            Iap2LinkEngine.SynchronizationPayload.decode(
+                payload(
+                    sessions =
+                        listOf(
+                            Iap2LinkEngine.SessionDescriptor(1, 0, 2),
+                            Iap2LinkEngine.SessionDescriptor(1, 2, 1),
+                        ),
+                ).encode(),
+            ),
+        )
+    }
+
+    @Test
+    fun invalidSessionKindAndVersionAreRejected() {
+        assertNull(
+            Iap2LinkEngine.SynchronizationPayload.decode(
+                payload(sessions = listOf(Iap2LinkEngine.SessionDescriptor(1, 3, 1))).encode(),
+            ),
+        )
+        assertNull(
+            Iap2LinkEngine.SynchronizationPayload.decode(
+                payload(sessions = listOf(Iap2LinkEngine.SessionDescriptor(1, 0, 0))).encode(),
+            ),
+        )
+    }
+
+    @Test
+    fun invalidWindowAndMaximumLengthAreRejected() {
+        assertNull(Iap2LinkEngine.SynchronizationPayload.decode(payload(maxOutgoing = 0).encode()))
+        assertNull(Iap2LinkEngine.SynchronizationPayload.decode(payload(maxOutgoing = 128).encode()))
+        assertNull(Iap2LinkEngine.SynchronizationPayload.decode(payload(maxLength = 63).encode()))
+        assertNotNull(Iap2LinkEngine.SynchronizationPayload.decode(payload(maxLength = 64).encode()))
+    }
+
+    @Test
+    fun randomPayloadsNeverThrowAndAcceptedPayloadsRoundTrip() {
+        val random = Random(0x4300)
+        repeat(5_000) {
+            val bytes = ByteArray(random.nextInt(0, 96)) { random.nextInt(0, 256).toByte() }
+            val decoded = Iap2LinkEngine.SynchronizationPayload.decode(bytes)
+            if (decoded != null) {
+                assertEquals(decoded, Iap2LinkEngine.SynchronizationPayload.decode(decoded.encode()))
+            }
+        }
+    }
+
+    private fun validSessions() =
+        listOf(
+            Iap2LinkEngine.SessionDescriptor(10, 0, 2),
+            Iap2LinkEngine.SessionDescriptor(11, 2, 1),
+            Iap2LinkEngine.SessionDescriptor(12, 1, 2),
+        )
+}
