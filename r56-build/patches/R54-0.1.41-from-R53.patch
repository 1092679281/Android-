diff --git a/app/src/main/java/com/mcarplay/app/iap2/MfiParameterEvidence.kt b/app/src/main/java/com/mcarplay/app/iap2/MfiParameterEvidence.kt
new file mode 100644
index 0000000..f2ef4b7
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/iap2/MfiParameterEvidence.kt
@@ -0,0 +1,51 @@
+package com.mcarplay.app.iap2
+
+/** Structural evidence only; this deliberately does not verify MFi certificates or signatures. */
+internal object MfiParameterEvidence {
+    data class Result(
+        val valid: Boolean,
+        val valueBytes: Int,
+        val reason: String?,
+    )
+
+    /**
+     * Validate that the complete parameter stream is well-formed and contains exactly one
+     * non-empty value for [expectedParameterId]. Other well-formed parameters are preserved.
+     */
+    fun inspectNonEmptyParameter(
+        body: ByteArray,
+        expectedParameterId: Int,
+    ): Result {
+        if (expectedParameterId !in 0..0xFFFF) return Result(false, 0, "invalid_expected_parameter")
+        if (body.isEmpty()) return Result(false, 0, "empty_body")
+
+        var offset = 0
+        var foundValueBytes: Int? = null
+        while (offset < body.size) {
+            if (body.size - offset < PARAMETER_HEADER_BYTES) {
+                return Result(false, 0, "truncated_parameter_header")
+            }
+            val length = readU16(body, offset)
+            if (length < PARAMETER_HEADER_BYTES) return Result(false, 0, "invalid_parameter_length")
+            if (length > body.size - offset) return Result(false, 0, "truncated_parameter_value")
+            val parameterId = readU16(body, offset + 2)
+            val valueBytes = length - PARAMETER_HEADER_BYTES
+            if (parameterId == expectedParameterId) {
+                if (foundValueBytes != null) return Result(false, 0, "duplicate_expected_parameter")
+                if (valueBytes == 0) return Result(false, 0, "empty_expected_parameter")
+                foundValueBytes = valueBytes
+            }
+            offset += length
+        }
+
+        return foundValueBytes?.let { Result(true, it, null) }
+            ?: Result(false, 0, "missing_expected_parameter")
+    }
+
+    private fun readU16(
+        bytes: ByteArray,
+        offset: Int,
+    ): Int = ((bytes[offset].toInt() and 0xFF) shl 8) or (bytes[offset + 1].toInt() and 0xFF)
+
+    private const val PARAMETER_HEADER_BYTES = 4
+}
