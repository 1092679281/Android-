+    private fun mutateSynFrame(
+        source: ByteArray,
+        control: Int? = null,
+        sessionId: Int? = null,
+    ): ByteArray {
+        val frame = source.copyOf()
+        val offset = 6 // leading marker
+        control?.let { frame[offset + 4] = it.toByte() }
+        sessionId?.let { frame[offset + 7] = it.toByte() }
+        var sum = 0
+        for (index in offset until offset + 8) sum += frame[index].toInt() and 0xFF
+        frame[offset + 8] = (-sum and 0xFF).toByte()
+        return frame
+    }
