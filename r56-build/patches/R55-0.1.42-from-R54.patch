+    /**
+     * Strict counterpart to [parseParams]. Unlike the compatibility parser above, this method
+     * rejects any trailing fragment, invalid TLV length, or value that extends past the body.
+     * Callers handling endpoint credentials must use this before adopting parsed fields.
+     */
+    fun parseParamsStrict(
+        body: ByteArray,
+        uniqueParameterIds: Set<Int> = emptySet(),
+    ): StrictParamParseResult {
+        val params = ArrayList<Param>()
+        var offset = 0
+        while (offset < body.size) {
+            val remaining = body.size - offset
+            if (remaining < PARAM_HEADER_BYTES) {
+                return StrictParamParseResult(null, "truncated_parameter_header")
+            }
+            val length = readU16(body, offset)
+            if (length < PARAM_HEADER_BYTES) {
+                return StrictParamParseResult(null, "invalid_parameter_length")
+            }
+            if (length > remaining) {
+                return StrictParamParseResult(null, "truncated_parameter_value")
+            }
+            params += Param(readU16(body, offset + 2), body.copyOfRange(offset + PARAM_HEADER_BYTES, offset + length))
+            offset += length
+        }
+        val duplicateId =
+            params.asSequence()
+                .filter { it.id in uniqueParameterIds }
+                .groupingBy { it.id }
+                .eachCount()
+                .entries
+                .firstOrNull { it.value > 1 }
+                ?.key
+        if (duplicateId != null) {
+            return StrictParamParseResult(null, "duplicate_parameter_id", duplicateId)
+        }
+        return StrictParamParseResult(params, null)
+    }
+
+    /** Return parameter IDs and value lengths only; never include raw TLV values in diagnostics. */
+    fun redactedParamsSummary(body: ByteArray): String {
+        val parsed = parseParamsStrict(body)
+        return parsed.params?.joinToString(" ") { "#${it.id}(${it.value.size}B)" }
+            ?: "invalid:${parsed.error ?: "unknown"}"
+    }
+
+    private const val PARAM_HEADER_BYTES = 4
+
     private fun readU16(
         bytes: ByteArray,
         offset: Int,
