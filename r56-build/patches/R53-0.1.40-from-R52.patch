+++ b/app/src/main/java/com/mcarplay/app/compat/ReceiverStoreIoRetry.kt
@@ -0,0 +1,49 @@
+package com.mcarplay.app.compat
+
+import java.io.IOException
+import java.io.InterruptedIOException
+
+/**
+ * Bounded retry for transient receiver-store I/O only.
+ *
+ * Format, schema, validation and cryptographic-binding failures are not IOExceptions and are
+ * deliberately not retried. This avoids treating corrupt or untrusted persisted state as a
+ * temporary storage outage. Interruption is also terminal and remains visible to the caller.
+ */
+internal object ReceiverStoreIoRetry {
+    const val MAX_ATTEMPTS = 3
+
+    fun delayBeforeRetryMillis(completedAttempt: Int): Long =
+        when (completedAttempt) {
+            1 -> 100L
+            2 -> 250L
+            else -> 0L
+        }
+
+    fun <T> execute(
+        sleep: (Long) -> Unit = { Thread.sleep(it) },
+        onRetry: (completedAttempt: Int, error: IOException) -> Unit = { _, _ -> },
+        operation: () -> T,
+    ): T {
+        var attempt = 0
+        while (true) {
+            attempt++
+            try {
+                return operation()
+            } catch (error: IOException) {
+                if (error is InterruptedIOException || Thread.currentThread().isInterrupted || attempt >= MAX_ATTEMPTS) {
+                    throw error
+                }
+                onRetry(attempt, error)
+                try {
+                    sleep(delayBeforeRetryMillis(attempt))
+                } catch (interrupted: InterruptedException) {
+                    Thread.currentThread().interrupt()
+                    throw InterruptedIOException("Receiver configuration store retry interrupted").also {
+                        it.initCause(interrupted)
+                    }
+                }
+            }
+        }
+    }
+}
