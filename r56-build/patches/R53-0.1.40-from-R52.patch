@@ -0,0 +1,105 @@
+package com.mcarplay.app.compat
+
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.IOException
+import java.io.InterruptedIOException
+
+class ReceiverStoreIoRetryTest {
+    @Test
+    fun retriesTransientIoAndReturnsFirstSuccessfulLoad() {
+        var calls = 0
+        val delays = mutableListOf<Long>()
+        val value =
+            ReceiverStoreIoRetry.execute(sleep = { delays += it }) {
+                calls++
+                if (calls == 1) throw IOException("temporary read failure")
+                "loaded"
+            }
+        assertTrue(value == "loaded")
+        assertTrue(calls == 2)
+        assertTrue(delays == listOf(100L))
+    }
+
+    @Test
+    fun usesBoundedBackoffForTwoTransientFailures() {
+        var calls = 0
+        val delays = mutableListOf<Long>()
+        val value =
+            ReceiverStoreIoRetry.execute(sleep = { delays += it }) {
+                calls++
+                if (calls < 3) throw IOException("temporary storage failure")
+                42
+            }
+        assertTrue(value == 42)
+        assertTrue(calls == 3)
+        assertTrue(delays == listOf(100L, 250L))
+    }
+
+    @Test
+    fun malformedStoreIsNotRetried() {
+        var calls = 0
+        val delays = mutableListOf<Long>()
+        val failed =
+            runCatching {
+                ReceiverStoreIoRetry.execute(sleep = { delays += it }) {
+                    calls++
+                    throw IllegalArgumentException("invalid schema")
+                }
+            }.isFailure
+        assertTrue(failed)
+        assertTrue(calls == 1)
+        assertTrue(delays.isEmpty())
+    }
+
+    @Test
+    fun stopsAfterMaximumAttempts() {
+        var calls = 0
+        val delays = mutableListOf<Long>()
+        val failed =
+            runCatching {
+                ReceiverStoreIoRetry.execute(sleep = { delays += it }) {
+                    calls++
+                    throw IOException("disk unavailable")
+                }
+            }.isFailure
+        assertTrue(failed)
+        assertTrue(calls == ReceiverStoreIoRetry.MAX_ATTEMPTS)
+        assertTrue(delays == listOf(100L, 250L))
+    }
+
+    @Test
+    fun interruptedIoIsNeverRetried() {
+        var calls = 0
+        val delays = mutableListOf<Long>()
+        val failed =
+            runCatching {
+                ReceiverStoreIoRetry.execute(sleep = { delays += it }) {
+                    calls++
+                    throw InterruptedIOException("cancelled")
+                }
+            }.exceptionOrNull()
+        assertTrue(failed is InterruptedIOException)
+        assertTrue(calls == 1)
+        assertTrue(delays.isEmpty())
+    }
+
+    @Test
+    fun interruptedBackoffPreservesThreadInterruptFlag() {
+        var calls = 0
+        val failure =
+            runCatching {
+                ReceiverStoreIoRetry.execute(sleep = { throw InterruptedException("cancelled") }) {
+                    calls++
+                    throw IOException("temporary read failure")
+                }
+            }.exceptionOrNull()
+        assertTrue(failure is InterruptedIOException)
+        assertTrue(calls == 1)
+        try {
+            assertTrue(Thread.currentThread().isInterrupted)
+        } finally {
+            Thread.interrupted()
+        }
+    }
+}
