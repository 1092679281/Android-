@@ -0,0 +1,66 @@
+package com.mcarplay.app.bt
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.Closeable
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import kotlin.concurrent.thread
+
+class PhoneSdpAdmissionTest {
+    private class Record : Closeable {
+        override fun close() = Unit
+    }
+
+    @Test
+    fun delayedAdmissionCannotRegisterAfterStopOrRestart() {
+        val opened = mutableListOf<Record>()
+        val listener = PhoneSdpListener({ Record() }, { opened.add(it) }, {})
+        var admitted = 0
+        listener.start()
+        val old = opened.single()
+        listener.stop()
+        assertFalse(listener.admit(old) { admitted++ })
+        listener.start()
+        assertFalse(listener.admit(old) { admitted++ })
+        assertTrue(listener.admit(opened.last()) { admitted++ })
+        assertEquals(1, admitted)
+        listener.stop()
+    }
+    @Test
+    fun stopCannotInterleaveWithAdmissionAction() {
+        val record = Record()
+        val listener = PhoneSdpListener({ record }, {}, {})
+        listener.start()
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val stopping = CountDownLatch(1)
+        val stopped = CountDownLatch(1)
+        val admitting = thread(isDaemon = true) {
+            listener.admit(record) {
+                entered.countDown()
+                release.await(2, TimeUnit.SECONDS)
+            }
+        }
+        try {
+            assertTrue(entered.await(2, TimeUnit.SECONDS))
+            val stopper = thread(isDaemon = true) {
+                stopping.countDown()
+                listener.stop()
+                stopped.countDown()
+            }
+            assertTrue(stopping.await(2, TimeUnit.SECONDS))
+            assertFalse(stopped.await(100, TimeUnit.MILLISECONDS))
+            release.countDown()
+            assertTrue(stopped.await(2, TimeUnit.SECONDS))
+            stopper.join(2000)
+            assertFalse(listener.admit(record) { error("retired record admitted") })
+        } finally {
+            release.countDown()
+            admitting.join(2000)
+            listener.stop()
+        }
+    }
+}
