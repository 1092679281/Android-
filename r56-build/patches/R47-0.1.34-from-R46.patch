@@ -0,0 +1,33 @@
+package com.mcarplay.app.net
+
+import java.io.Closeable
+import java.util.Collections
+import java.util.IdentityHashMap
+
+/** Bounds active client work. The advertiser serializes admission with server start/stop. */
+internal class CtrlClientRegistry<T : Closeable>(
+    private val limit: Int,
+) {
+    init {
+        require(limit > 0)
+    }
+
+    private val clients = Collections.newSetFromMap(IdentityHashMap<T, Boolean>())
+
+    @Synchronized
+    fun tryRegister(client: T): Boolean = clients.size < limit && clients.add(client)
+
+    @Synchronized
+    fun remove(client: T) {
+        clients.remove(client)
+    }
+
+    fun closeAll() {
+        val retired =
+            synchronized(this) {
+                // Keep slots charged until their workers finish, including across a restart.
+                clients.toList()
+            }
+        retired.forEach { runCatching { it.close() } }
+    }
+}
