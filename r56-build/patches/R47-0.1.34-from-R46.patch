+
+class ConnectionTimelineFreezeTest {
+    @Test
+    fun videoAgeAndElapsedFreezeAtEnd() {
+        var now = 0L
+        val timeline = ConnectionTimeline({ now }, { now }, { "test" }, {})
+        val id = timeline.begin("test")
+        now = 100
+        timeline.media(id, true, 1)
+        now = 200
+        timeline.finish(id, DiagnosticCode.USER_STOP, false)
+        val ended = timeline.snapshot()!!
+        now = 9000
+        val later = timeline.snapshot()!!
+        assertEquals(100L, ended.lastVideoMsAgo)
+        assertEquals(ended.lastVideoMsAgo, later.lastVideoMsAgo)
+        assertEquals(ended.elapsedMs, later.elapsedMs)
+        assertEquals(ended.stageDurations, later.stageDurations)
+    }
+}
