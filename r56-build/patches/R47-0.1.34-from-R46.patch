+package com.mcarplay.app.net
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.Closeable
+import java.io.IOException
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+class CtrlClientRegistryTest {
+    private class Client(private val broken: Boolean = false) : Closeable {
+        var closed = 0
+
+        override fun close() {
+            closed++
+            if (broken) throw IOException("test")
+        }
+    }
+
+    @Test
+    fun saturationAndShutdownCloseAllAdmittedClientsEvenIfOneThrows() {
+        val registry = CtrlClientRegistry<Client>(2)
+        val first = Client(true)
+        val second = Client()
+        val third = Client()
+        assertTrue(registry.tryRegister(first))
+        assertTrue(registry.tryRegister(second))
+        assertFalse(registry.tryRegister(third))
+        registry.closeAll()
+        assertEquals(1, first.closed)
+        assertEquals(1, second.closed)
+        assertEquals(0, third.closed)
+        assertFalse(registry.tryRegister(third))
+        registry.remove(second)
+        assertTrue(registry.tryRegister(third))
+        registry.remove(first)
+        registry.closeAll()
+        assertEquals(1, third.closed)
+    }
+
+    @Test
+    fun concurrentAdmissionsCannotExceedLimit() {
+        val registry = CtrlClientRegistry<Client>(8)
+        val workers = Executors.newFixedThreadPool(16)
+        val start = CountDownLatch(1)
+        try {
+            val results = List(32) {
+                workers.submit<Boolean> {
+                    start.await()
+                    registry.tryRegister(Client())
+                }
+            }
+            start.countDown()
+            assertEquals(8, results.count { it.get(3, TimeUnit.SECONDS) })
+        } finally {
+            registry.closeAll()
+            workers.shutdownNow()
+        }
+    }
+}
