+package com.mcarplay.app.net
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class NetworkBindingFaultTest {
+    @Test
+    fun failedUnbindIsRetriedBeforeReplacementCanBind() {
+        var allowUnbind = false
+        var failures = 0
+        val calls = mutableListOf<Int?>()
+        val binding = NetworkBinding<Int, Any>(
+            bindProcess = { value ->
+                calls.add(value)
+                value != null || allowUnbind
+            },
+            isUsable = { true },
+            onUnbindFailure = { failures++ },
+        )
+        val old = Any()
+        val next = Any()
+        binding.replaceRequest(old)
+        assertTrue(binding.bind(old, 1))
+        binding.replaceRequest(next)
+        assertFalse(binding.bind(next, 2))
+        assertNull(binding.current())
+        assertEquals(3, failures)
+        assertTrue(binding.hasPendingUnbind())
+        assertFalse(binding.releaseIfCurrent(old))
+        allowUnbind = true
+        assertTrue(binding.bind(next, 2))
+        assertEquals(listOf(1, null, null, null, null, 2), calls)
+        assertEquals(2, binding.current())
+        assertFalse(binding.hasPendingUnbind())
+    }
+
+    @Test
+    fun exceptionDuringUnbindDoesNotForgetPendingCleanup() {
+        var throwOnUnbind = true
+        val binding = NetworkBinding<Int, Any>(
+            bindProcess = { value -> if (value == null && throwOnUnbind) error("OS failure") else true },
+            isUsable = { true },
+        )
+        val owner = Any()
+        binding.replaceRequest(owner)
+        assertTrue(binding.bind(owner, 1))
+        assertTrue(binding.releaseIfCurrent(owner))
+        assertNull(binding.current())
+        throwOnUnbind = false
+        binding.replaceRequest(owner)
+        assertTrue(binding.bind(owner, 2))
+    }
+}
