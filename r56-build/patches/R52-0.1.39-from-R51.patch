+++ b/app/src/test/java/com/mcarplay/app/compat/ReceiverStoreReadinessTest.kt
@@ -0,0 +1,95 @@
+package com.mcarplay.app.compat
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+
+class ReceiverStoreReadinessTest {
+    @Test
+    fun returnsImmediatelyWhenStoreWasAlreadyLoaded() {
+        val gate = ReceiverStoreReadiness()
+        gate.complete(true)
+        assertTrue(gate.await(0))
+    }
+
+    @Test
+    fun waitsForSuccessfulInitializationWithinBoundedDeadline() {
+        val gate = ReceiverStoreReadiness()
+        val result = AtomicBoolean(false)
+        val finished = CountDownLatch(1)
+        val worker = Thread {
+            result.set(gate.await(1_000))
+            finished.countDown()
+        }
+        worker.start()
+        Thread.sleep(25)
+        gate.complete(true)
+        assertTrue(finished.await(1, TimeUnit.SECONDS))
+        assertTrue(result.get())
+    }
+
+    @Test
+    fun initializationFailureUnblocksWaitersAsNotReady() {
+        val gate = ReceiverStoreReadiness()
+        val result = AtomicBoolean(true)
+        val finished = CountDownLatch(1)
+        Thread {
+            result.set(gate.await(1_000))
+            finished.countDown()
+        }.start()
+        Thread.sleep(25)
+        gate.complete(false)
+        assertTrue(finished.await(1, TimeUnit.SECONDS))
+        assertFalse(result.get())
+    }
+
+    @Test
+    fun timeoutDoesNotWaitForeverAndLaterCompletionCanBeObserved() {
+        val gate = ReceiverStoreReadiness()
+        assertFalse(gate.await(15))
+        gate.complete(true)
+        assertTrue(gate.await(0))
+    }
+
+    @Test
+    fun completionIsOneShotAndCannotBeReversed() {
+        val gate = ReceiverStoreReadiness()
+        gate.complete(false)
+        gate.complete(true)
+        assertFalse(gate.await(0))
+    }
+
+    @Test
+    fun interruptedWaiterReturnsNotReadyAndPreservesInterruptFlag() {
+        val gate = ReceiverStoreReadiness()
+        Thread.currentThread().interrupt()
+        try {
+            assertFalse(gate.await(1_000))
+            assertTrue(Thread.currentThread().isInterrupted)
+        } finally {
+            Thread.interrupted()
+        }
+    }
+
+    @Test
+    fun multipleWaitersAreReleasedByOneCompletion() {
+        val gate = ReceiverStoreReadiness()
+        val start = CountDownLatch(3)
+        val done = CountDownLatch(3)
+        val successes = AtomicBoolean(true)
+        repeat(3) {
+            Thread {
+                start.countDown()
+                if (!gate.await(1_000)) successes.set(false)
+                done.countDown()
+            }.start()
+        }
+        assertTrue(start.await(1, TimeUnit.SECONDS))
+        gate.complete(true)
+        assertTrue(done.await(1, TimeUnit.SECONDS))
+        assertTrue(successes.get())
+    }
+}
