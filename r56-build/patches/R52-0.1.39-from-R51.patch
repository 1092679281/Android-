+++ b/app/src/main/java/com/mcarplay/app/compat/ReceiverStoreReadiness.kt
@@ -0,0 +1,41 @@
+package com.mcarplay.app.compat
+
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/**
+ * One-shot result of loading the private receiver store.
+ *
+ * Bluetooth session workers may wait briefly for startup I/O, but must never wait indefinitely.
+ * A failed initialization is terminal for this process and is reported as not-ready.
+ */
+internal class ReceiverStoreReadiness {
+    private val completedLatch = CountDownLatch(1)
+
+    @Volatile
+    private var completed = false
+
+    @Volatile
+    private var ready = false
+
+    fun complete(isReady: Boolean) {
+        synchronized(this) {
+            if (completed) return
+            ready = isReady
+            completed = true
+            completedLatch.countDown()
+        }
+    }
+
+    fun await(timeoutMillis: Long): Boolean {
+        if (completed) return ready
+        if (timeoutMillis <= 0L) return false
+        return try {
+            completedLatch.await(timeoutMillis, TimeUnit.MILLISECONDS) && ready
+        } catch (_: InterruptedException) {
+            Thread.currentThread().interrupt()
+            false
+        }
+    }
+
+}
diff --git a/app/src/test/java/com/mcarplay/app/compat/ReceiverStoreReadinessTest.kt b/app/src/test/java/com/mcarplay/app/compat/ReceiverStoreReadinessTest.kt
