 }
+
+
+/**
+ * One-way evidence gate for the E2LB 0x4300 A/B experiment.
+ * A DUAL_GROUP attempt is only auto-fallen-back after a completed local write is followed by
+ * a peer-initiated iAP2 restart before 0x4301. This is an A/B compatibility probe, not proof that
+ * the DUAL_GROUP body caused the peer restart.
+ */
+internal object E2lbAvailabilityFallbackPolicy {
+    fun shouldFallbackToSingleGroup(
+        isE2lb: Boolean,
+        shape: E2lbAvailabilityBodyPolicy.Shape?,
+        state: Iap2AvailabilityProgress.State,
+        terminationReason: String?,
+        receiptState: Iap2LinkEngine.ControlReceipt.State?,
+        receiptEndedFrom: Iap2LinkEngine.ControlReceipt.State?,
+        receiptLocalWriteCompleted: Boolean?,
+        startSessionReceived: Boolean,
+    ): Boolean =
+        isE2lb &&
+            shape == E2lbAvailabilityBodyPolicy.Shape.DUAL_GROUP &&
+            state == Iap2AvailabilityProgress.State.LINK_ENDED &&
+            terminationReason?.startsWith("peer restarted iAP2 negotiation") == true &&
+            receiptState == Iap2LinkEngine.ControlReceipt.State.ENDED &&
+            receiptEndedFrom == Iap2LinkEngine.ControlReceipt.State.FRAME_GENERATED &&
+            receiptLocalWriteCompleted == true &&
+            !startSessionReceived
+}
