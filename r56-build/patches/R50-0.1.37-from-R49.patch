index 0000000..0ff001b
--- /dev/null
+++ b/app/src/test/java/com/mcarplay/app/iap2/E2lbAvailabilityFallbackPolicyTest.kt
@@ -0,0 +1,49 @@
+package com.mcarplay.app.iap2
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class E2lbAvailabilityFallbackPolicyTest {
+    private fun shouldFallback(
+        isE2lb: Boolean = true,
+        shape: E2lbAvailabilityBodyPolicy.Shape? = E2lbAvailabilityBodyPolicy.Shape.DUAL_GROUP,
+        state: Iap2AvailabilityProgress.State = Iap2AvailabilityProgress.State.LINK_ENDED,
+        reason: String? = "peer restarted iAP2 negotiation (seq=118 oldSeq=204)",
+        receipt: Iap2LinkEngine.ControlReceipt.State? = Iap2LinkEngine.ControlReceipt.State.ENDED,
+        endedFrom: Iap2LinkEngine.ControlReceipt.State? = Iap2LinkEngine.ControlReceipt.State.FRAME_GENERATED,
+        localWrite: Boolean? = true,
+        start: Boolean = false,
+    ) = E2lbAvailabilityFallbackPolicy.shouldFallbackToSingleGroup(
+        isE2lb,
+        shape,
+        state,
+        reason,
+        receipt,
+        endedFrom,
+        localWrite,
+        start,
+    )
+
+    @Test
+    fun onlyWrittenDualGroupFollowedByPeerRestartTriggersFallback() {
+        assertTrue(shouldFallback())
+    }
+
+    @Test
+    fun otherReceiversAndSingleGroupNeverFallback() {
+        assertFalse(shouldFallback(isE2lb = false))
+        assertFalse(shouldFallback(shape = E2lbAvailabilityBodyPolicy.Shape.SINGLE_GROUP))
+        assertFalse(shouldFallback(shape = null))
+    }
+
+    @Test
+    fun incompleteOrUnrelatedFailuresNeverFallback() {
+        assertFalse(shouldFallback(localWrite = false))
+        assertFalse(shouldFallback(endedFrom = Iap2LinkEngine.ControlReceipt.State.QUEUED))
+        assertFalse(shouldFallback(reason = "packet 110 not acknowledged"))
+        assertFalse(shouldFallback(state = Iap2AvailabilityProgress.State.DETECT_ONLY))
+        assertFalse(shouldFallback(receipt = Iap2LinkEngine.ControlReceipt.State.PEER_ACKED))
+        assertFalse(shouldFallback(start = true))
+    }
+}
