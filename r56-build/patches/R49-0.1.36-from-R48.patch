+/** Decode an AirPlay receiver identifier without replacement characters or log-control bytes. */
+internal fun decodeReceiverIdentifier(bytes: ByteArray?, stage: String): String {
+    if (bytes == null || bytes.isEmpty() || bytes.size > MAX_RECEIVER_IDENTIFIER_BYTES) {
+        throw UntrustedReceiverIdentityException("$stage: 接收端 identifier 缺失或长度无效")
+    }
+    val decoded =
+        try {
+            Charsets.UTF_8
+                .newDecoder()
+                .onMalformedInput(CodingErrorAction.REPORT)
+                .onUnmappableCharacter(CodingErrorAction.REPORT)
+                .decode(ByteBuffer.wrap(bytes))
+                .toString()
+        } catch (_: CharacterCodingException) {
+            throw UntrustedReceiverIdentityException("$stage: 接收端 identifier 不是合法 UTF-8")
+        }
+    if (decoded.isBlank() || decoded.any { Character.isISOControl(it) }) {
+        throw UntrustedReceiverIdentityException("$stage: 接收端 identifier 为空或包含控制字符")
+    }
+    return decoded
+}
+
+/** Stable, non-reversible diagnostic label; never write the raw receiver identifier to logs. */
+internal fun receiverIdentifierFingerprint(bytes: ByteArray): String =
+    MessageDigest.getInstance("SHA-256")
+        .digest(bytes)
+        .take(6)
+        .joinToString("") { "%02x".format(it.toInt() and 0xFF) }
+
+private const val MAX_RECEIVER_IDENTIFIER_BYTES = 255
