diff --git a/app/src/main/java/com/mcarplay/app/video/ProjectionNavigationNotice.kt b/app/src/main/java/com/mcarplay/app/video/ProjectionNavigationNotice.kt
new file mode 100644
index 0000000000000000000000000000000000000000..a1c1e2daf97c94adf04b13f4a861b41c863150d7
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/video/ProjectionNavigationNotice.kt
@@ -0,0 +1,82 @@
+package com.mcarplay.app.video
+
+/** Only explicitly classified ongoing navigation notices from supported map apps are eligible. */
+internal data class ProjectionNavigationNotice(val provider: String, val title: String, val body: String)
+
+internal object ProjectionNavigationNoticePolicy {
+    private val providers = mapOf(
+        "com.autonavi.minimap" to "高德地图 / Amap",
+        "com.baidu.BaiduMap" to "百度地图 / Baidu Maps",
+        "com.tencent.map" to "腾讯地图 / Tencent Maps",
+        "com.google.android.apps.maps" to "Google Maps",
+    )
+
+    fun provider(packageName: String, category: String?, ongoing: Boolean, secret: Boolean, summary: Boolean): String? =
+        providers[packageName]?.takeIf { category == "navigation" && ongoing && !secret && !summary }
+
+    private fun clean(value: CharSequence?): String =
+        value?.take(160)?.toString()?.map { ch ->
+            if (ch.isWhitespace() || ch.isISOControl() || Character.getType(ch) == Character.FORMAT.toInt()) ' ' else ch
+        }?.joinToString("")?.trim()?.replace(Regex(" +"), " ").orEmpty()
+
+    fun notice(provider: String, title: CharSequence?, body: CharSequence?): ProjectionNavigationNotice? {
+        val t = clean(title)
+        val b = clean(body).takeUnless { it == t }.orEmpty()
+        return if (t.isEmpty() && b.isEmpty()) null else ProjectionNavigationNotice(provider, t, b)
+    }
+}
+
+/** In-memory only. A projection owner and epoch prevent results crossing sessions. */
+internal class ProjectionNavigationNoticeStore {
+    private var enabled = false
+    private var connected = false
+    private var owner: Any? = null
+    private var epoch = 0L
+    private var value: ProjectionNavigationNotice? = null
+
+    private fun invalidate() {
+        epoch++
+        value = null
+    }
+
+    @Synchronized
+    fun setEnabled(next: Boolean) {
+        if (enabled != next) {
+            enabled = next
+            invalidate()
+        }
+    }
+
+    @Synchronized
+    fun setConnected(next: Boolean) {
+        connected = next
+        invalidate()
+    }
+
+    @Synchronized
+    fun attach(next: Any) {
+        owner = next
+        invalidate()
+    }
+
+    @Synchronized
+    fun detach(previous: Any) {
+        if (owner === previous) {
+            owner = null
+            invalidate()
+        }
+    }
+
+    @Synchronized
+    fun requestEpoch(): Long? = epoch.takeIf { enabled && connected && owner != null }
+
+    @Synchronized
+    fun publish(request: Long, notice: ProjectionNavigationNotice?) {
+        if (request == requestEpoch()) value = notice
+    }
+
+    @Synchronized
+    fun snapshot(forOwner: Any): ProjectionNavigationNotice? = value.takeIf { owner === forOwner && enabled && connected }
+}
+
+internal val projectionNavigationNotices = ProjectionNavigationNoticeStore()
