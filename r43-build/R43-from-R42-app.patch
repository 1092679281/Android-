+    @Test
+    fun consentAndListenerLifecycleGateData() {
+        val store = ProjectionNavigationNoticeStore()
+        val owner = Any()
+        val newer = Any()
+        val n = ProjectionNavigationNotice("map", "right", "")
+        assertNull(store.requestEpoch())
+        store.attach(owner)
+        store.setConnected(true)
+        assertNull(store.requestEpoch())
+        store.setEnabled(true)
+        val epoch = store.requestEpoch()!!
+        store.publish(epoch, n)
+        assertEquals(n, store.snapshot(owner))
+        store.publish(epoch, null)
+        assertNull(store.snapshot(owner))
+        store.setEnabled(false)
+        store.publish(epoch, n)
+        assertNull(store.snapshot(owner))
+        store.setEnabled(true)
+        store.publish(epoch, n)
+        assertNull(store.snapshot(owner))
+        val next = store.requestEpoch()!!
+        store.attach(newer)
+        store.publish(next, n)
+        assertNull(store.snapshot(newer))
+        store.detach(owner)
+        store.publish(store.requestEpoch()!!, n)
+        assertEquals(n, store.snapshot(newer))
+        store.detach(newer)
+        assertNull(store.requestEpoch())
+        assertNull(store.snapshot(newer))
+    }
