+    @Test
+    fun randomizedConsentAndConnectionTransitions() {
+        val store = ProjectionNavigationNoticeStore()
+        val owner = Any()
+        store.attach(owner)
+        val random = Random(43)
+        var enabled = false
+        var connected = false
+        var expected: ProjectionNavigationNotice? = null
+        repeat(10000) {
+            when (random.nextInt(4)) {
+                0 -> {
+                    enabled = random.nextBoolean()
+                    store.setEnabled(enabled)
+                    if (!enabled) expected = null
+                }
+                1 -> {
+                    connected = random.nextBoolean()
+                    store.setConnected(connected)
+                    expected = null
+                }
+                else -> {
+                    val n = if (random.nextBoolean()) ProjectionNavigationNotice("map", "$it", "") else null
+                    store.requestEpoch()?.let { epoch -> store.publish(epoch, n) }
+                    if (enabled && connected) expected = n
+                }
+            }
+            assertEquals(expected, store.snapshot(owner))
+            assertEquals(enabled && connected, store.requestEpoch() != null)
+        }
+        println("navigation consent transitions: 10000")
+    }
