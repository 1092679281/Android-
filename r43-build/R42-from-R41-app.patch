index 0000000000000000000000000000000000000000..6d012514530df1eaba9d2d696d1316e7fb0ad0a7
--- /dev/null
+++ b/app/src/test/java/com/mcarplay/app/video/ProjectionNavigationStatusTest.kt
@@ -0,0 +1,94 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class ProjectionNavigationStatusTest {
+    @Test
+    fun quietSourceIsNotRecovery() {
+        val m = ProjectionSourceMonitor()
+        assertEquals(ProjectionSourceStatus.WAITING, m.status(100))
+        m.frameLatched(1000, 100)
+        assertEquals(ProjectionSourceStatus.UPDATING, m.status(2_000_000_100))
+        assertEquals(ProjectionSourceStatus.STILL, m.status(2_000_000_101))
+        m.frameLatched(2000, 3_000_000_000)
+        assertEquals(ProjectionSourceStatus.UPDATING, m.status(3_000_000_001))
+    }
+
+    @Test
+    fun recoveryWaitsForPostGapKeyframeTimestamp() {
+        val m = ProjectionSourceMonitor()
+        m.frameLatched(100_000, 100_000)
+        m.gap()
+        m.frameLatched(200_000, 200_000)
+        assertEquals(ProjectionSourceStatus.RECOVERING, m.status(200_000))
+        m.keyFrameQueued(300)
+        m.frameLatched(299_999, 300_000)
+        assertEquals(ProjectionSourceStatus.RECOVERING, m.status(300_000))
+        m.frameLatched(0, 301_000)
+        assertEquals(ProjectionSourceStatus.RECOVERING, m.status(301_000))
+        m.frameLatched(300_000, 302_000)
+        assertEquals(ProjectionSourceStatus.UPDATING, m.status(302_000))
+    }
+
+    @Test
+    fun repeatedGapInvalidatesOldRecoveryFence() {
+        val random = Random(42)
+        repeat(10_000) {
+            val m = ProjectionSourceMonitor()
+            val first = random.nextLong(1, 100_000_000)
+            val second = first + random.nextLong(1, 1_000)
+            m.gap()
+            m.keyFrameQueued(first)
+            m.gap()
+            m.keyFrameQueued(second)
+            m.frameLatched(first * 1000, first * 1000)
+            assertEquals(ProjectionSourceStatus.RECOVERING, m.status(second * 1000))
+            m.frameLatched(second * 1000, second * 1000)
+            assertEquals(ProjectionSourceStatus.UPDATING, m.status(second * 1000))
+        }
+    }
+
+    @Test
+    fun statusCardDoesNotShrinkOrCoverSource() {
+        val random = Random(4201)
+        var count = 0
+        var cards = 0
+        repeat(20_000) {
+            val w = random.nextInt(640, 2561)
+            val h = random.nextInt(360, 1081)
+            if (!ProjectedDashboardLayout.supports(w, h)) return@repeat
+            val l = ProjectedDashboardLayout(w, h, random.nextInt(320, 3841), random.nextInt(180, 2161),
+                random.nextBoolean(), page = ProjectionPage.NAVIGATION, shell = true)
+            val r = l.navigationStatus
+            count++
+            if (r != null) {
+                cards++
+                assertTrue(r.width >= h * .30f - 1 && r.height >= h * .10f - 1)
+                assertTrue(r.left >= l.workspace.left && r.top >= l.workspace.top)
+                assertTrue(r.right <= l.workspace.right && r.bottom <= l.workspace.bottom)
+                fun disjoint(b: ProjectionRect) = r.right <= b.left || b.right <= r.left || r.bottom <= b.top || b.bottom <= r.top
+                assertTrue(disjoint(l.video))
+                l.miniPanel?.let { assertTrue(disjoint(it)) }
+                val result = DashboardTouchRouter().route(l, r.left, r.top, true, 1920, 1080)
+                assertNull(result.point)
+                assertNull(result.action)
+                assertNull(result.page)
+            }
+            assertNull(l.withPage(ProjectionPage.MUSIC).navigationStatus)
+        }
+        assertTrue(count > 10_000 && cards > 1_000)
+        println("R42 navigation layouts=$count cards=$cards")
+    }
+
+    @Test
+    fun fullContentKeepsUnmodifiedVideoGeometry() {
+        val full = ProjectedDashboardLayout(1920, 1080, 1920, 1080, fullContent = true, shell = true,
+            page = ProjectionPage.NAVIGATION)
+        assertEquals(ProjectionRect(0, 0, 1920, 1080), full.video)
+        assertNull(full.navigationStatus)
+    }
+}
