diff --git a/app/src/main/java/com/mcarplay/app/video/ProjectionNavigationStatus.kt b/app/src/main/java/com/mcarplay/app/video/ProjectionNavigationStatus.kt
new file mode 100644
index 0000000000000000000000000000000000000000..d8e5aa4c669b55dba105773eec01f7f941ffb186
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/video/ProjectionNavigationStatus.kt
@@ -0,0 +1,69 @@
+package com.mcarplay.app.video
+
+internal enum class ProjectionSourceStatus { WAITING, UPDATING, STILL, RECOVERING }
+
+/** Input gaps are explicit evidence; a quiet map alone is not a connection failure. */
+internal class ProjectionSourceMonitor {
+    private var lastFrameNs: Long? = null
+    private var recovering = false
+    private var recoveryPtsUs: Long? = null
+
+    @Synchronized
+    fun gap() {
+        recovering = true
+        recoveryPtsUs = null
+    }
+
+    @Synchronized
+    fun keyFrameQueued(ptsUs: Long) {
+        if (recovering && recoveryPtsUs == null && ptsUs > 0) recoveryPtsUs = ptsUs
+    }
+
+    @Synchronized
+    fun frameLatched(ptsNs: Long, nowNs: Long) {
+        lastFrameNs = nowNs
+        // A delayed pre-gap decoder output must not claim recovery. Surface timestamps use ns.
+        val fence = recoveryPtsUs
+        if (recovering && fence != null && ptsNs > 0 && ptsNs / 1_000L >= fence) {
+            recovering = false
+            recoveryPtsUs = null
+        }
+    }
+
+    @Synchronized
+    fun status(nowNs: Long): ProjectionSourceStatus {
+        if (recovering) return ProjectionSourceStatus.RECOVERING
+        val last = lastFrameNs ?: return ProjectionSourceStatus.WAITING
+        return if (nowNs >= last && nowNs - last > 2_000_000_000L) {
+            ProjectionSourceStatus.STILL
+        } else ProjectionSourceStatus.UPDATING
+    }
+}
+
+/** A passive status card may occupy letterbox space, never alter the video or control geometry. */
+internal object ProjectionNavigationStatus {
+    fun card(workspace: ProjectionRect, video: ProjectionRect, mini: ProjectionRect?, gap: Int, height: Int): ProjectionRect? {
+        val candidates = if (mini != null) {
+            listOf(
+                ProjectionRect(mini.left, workspace.top, mini.right, mini.top - gap),
+                ProjectionRect(mini.left, mini.bottom + gap, mini.right, workspace.bottom),
+            )
+        } else {
+            listOf(
+                ProjectionRect(workspace.left, workspace.top, workspace.right, video.top - gap),
+                ProjectionRect(workspace.left, video.bottom + gap, workspace.right, workspace.bottom),
+                ProjectionRect(workspace.left, video.top, video.left - gap, video.bottom),
+                ProjectionRect(video.right + gap, video.top, workspace.right, video.bottom),
+            )
+        }
+        return candidates.filter { it.width >= height * .30f && it.height >= height * .10f }
+            .maxByOrNull { it.width.toLong() * it.height }
+            ?.let { r ->
+                val w = minOf(r.width, (height * .70f).toInt())
+                val h = minOf(r.height, (height * .16f).toInt())
+                val x = r.left + (r.width - w) / 2
+                val y = r.top + (r.height - h) / 2
+                ProjectionRect(x, y, x + w, y + h)
+            }
+    }
+}
