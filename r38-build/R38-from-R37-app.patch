diff --git a/app/src/test/java/com/mcarplay/app/video/ProjectionWidgetsTest.kt b/app/src/test/java/com/mcarplay/app/video/ProjectionWidgetsTest.kt
new file mode 100644
index 0000000..f431d6b
--- /dev/null
+++ b/app/src/test/java/com/mcarplay/app/video/ProjectionWidgetsTest.kt
@@ -0,0 +1,92 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class ProjectionWidgetsTest {
+    @Test
+    fun batteryIsCachedButPacingTargetChangesImmediately() {
+        val sampler = ProjectionWidgetSampler()
+        var reads = 0
+        val read = { ProjectionPhoneStatus(++reads, true) }
+        assertEquals(1, sampler.sample(0L, 60, read).phone.batteryPercent)
+        assertEquals(30, sampler.sample(4_999L, 30, read).targetFps)
+        assertEquals(1, reads)
+        assertEquals(2, sampler.sample(5_000L, 45, read).phone.batteryPercent)
+        assertEquals(3, sampler.sample(1L, 60, read).phone.batteryPercent)
+    }
+
+    @Test
+    fun unavailableAndInvalidReadingsNeverPretendToBeZero() {
+        val sampler = ProjectionWidgetSampler()
+        assertNull(sampler.sample(0L, -1) { ProjectionPhoneStatus(Int.MIN_VALUE, null) }.phone.batteryPercent)
+        assertNull(sampler.sample(1L, 121) { error("not reached") }.targetFps)
+        assertEquals(0, sampler.sample(5_000L, 30) { ProjectionPhoneStatus(0, false) }.phone.batteryPercent)
+        assertEquals(ProjectionPhoneStatus(null, null), sampler.sample(10_000L, 30) { error("service failure") }.phone)
+        assertEquals(100, sampler.sample(15_000L, 60) { ProjectionPhoneStatus(100, true) }.phone.batteryPercent)
+    }
+
+    @Test
+    fun unrelatedMusicChangesDoNotInvalidateWidgets() {
+        val status = ProjectionWidgetStatus(ProjectionPhoneStatus(72, false), 60)
+        val key = DashboardVisualKey("12:00", "Wed", "a", "b", true, true, 5, null, widgets = status)
+        assertFalse(key.copy(title = "other", progressPixels = 50, playing = false).widgetsChangedFrom(key))
+        assertTrue(key.copy(clock = "12:01").widgetsChangedFrom(key))
+        assertTrue(key.copy(date = "Thu").widgetsChangedFrom(key))
+        assertTrue(key.copy(widgets = status.copy(targetFps = 30)).widgetsChangedFrom(key))
+        assertTrue(key.copy(widgets = status.copy(phone = ProjectionPhoneStatus(72, true))).widgetsChangedFrom(key))
+    }
+
+    @Test
+    fun widgetGlassCardsFitAndDoNotOverlapAtAnySupportedAspectRatio() {
+        val random = Random(38)
+        var checked = 0
+        repeat(20_000) {
+            val w = random.nextInt(640, 3001)
+            val h = random.nextInt(360, 1081)
+            if (!ProjectedDashboardLayout.supports(w, h)) return@repeat
+            val layout = ProjectedDashboardLayout(w, h, 1920, 1080, true, shell = true).withPage(ProjectionPage.WIDGETS)
+            val (left, right) = layout.widgetCards
+            assertTrue(left.right < right.left)
+            assertEquals(layout.workspace.left, left.left)
+            assertEquals(layout.workspace.right, right.right)
+            assertTrue(left.width > h * .09f && right.width > h * .09f)
+            assertTrue(layout.rail.right < left.left)
+            assertEquals(listOf(layout.rail, left, right), ProjectionGlass.panels(layout))
+            assertFalse(layout.showsVideo)
+            checked++
+        }
+        assertTrue(checked > 10_000)
+        println("R38 widget geometry: $checked supported layouts")
+    }
+
+    @Test
+    fun randomSamplingRespectsPollingAndMissingValues() {
+        val random = Random(380)
+        val sampler = ProjectionWidgetSampler()
+        var now = 0L
+        var last: Long? = null
+        var expected: Int? = null
+        var calls = 0
+        var expectedCalls = 0
+        repeat(100_000) {
+            now += random.nextLong(0, 250)
+            val input = random.nextInt(-10, 111)
+            if (last == null || now - requireNotNull(last) >= 5_000) {
+                expected = input.takeIf { it in 0..100 }
+                last = now
+                expectedCalls++
+            }
+            val fps = listOf(24, 30, 45, 50, 60).random(random)
+            val sample = sampler.sample(now, fps) { calls++; ProjectionPhoneStatus(input, null) }
+            assertEquals(expected, sample.phone.batteryPercent)
+            assertEquals(fps, sample.targetFps)
+            assertEquals(expectedCalls, calls)
+        }
+        println("R38 widget polling: 100000 ticks, $calls phone reads")
+    }
+}
