@@ -0,0 +1,23 @@
+package com.mcarplay.app.video
+
+/** Phone readings only. Missing or malformed values remain unavailable, never fabricated. */
+data class ProjectionPhoneStatus(val batteryPercent: Int?, val charging: Boolean?) {
+    fun validated(): ProjectionPhoneStatus = copy(batteryPercent = batteryPercent?.takeIf { it in 0..100 })
+}
+
+internal data class ProjectionWidgetStatus(val phone: ProjectionPhoneStatus, val targetFps: Int?)
+
+/** GL-thread-only sampler. Do not call Android battery services at video frame cadence. */
+internal class ProjectionWidgetSampler(private val pollMs: Long = 5_000L) {
+    private var lastPoll: Long? = null
+    private var phone = ProjectionPhoneStatus(null, null)
+
+    fun sample(nowMs: Long, targetFps: Int, readPhone: () -> ProjectionPhoneStatus): ProjectionWidgetStatus {
+        val previous = lastPoll
+        if (previous == null || nowMs < previous || nowMs - previous >= pollMs) {
+            phone = runCatching { readPhone().validated() }.getOrDefault(ProjectionPhoneStatus(null, null))
+            lastPoll = nowMs
+        }
+        return ProjectionWidgetStatus(phone, targetFps.takeIf { it in 1..120 })
+    }
+}
