@@ -1,22 +1,37 @@
 package com.mcarplay.app.video
 
+import java.util.Locale
+
 /** Local dashboard failure only: never infer a codec fault from a network disconnect. */
 internal class ProjectionRecoveryPolicy(private val cooldownMs: Long = 600_000L) {
-    private var failedPeer: String? = null
-    private var failedAtMs = 0L
+    private val failedPeers = LinkedHashMap<String, Long>()
 
     @Synchronized
     fun recordLocalFailure(peer: String?, nowMs: Long) {
-        if (peer.isNullOrBlank()) return
-        failedPeer = peer
-        failedAtMs = nowMs
+        val key = peerKey(peer) ?: return
+        failedPeers.entries.removeAll { (_, failedAt) -> !isCoolingDown(failedAt, nowMs) }
+        failedPeers.remove(key)
+        failedPeers[key] = nowMs
+        while (failedPeers.size > MAX_TRACKED_PEERS) {
+            failedPeers.remove(failedPeers.keys.first())
+        }
     }
 
     @Synchronized
     fun allowsDashboard(peer: String?, nowMs: Long): Boolean {
-        if (peer.isNullOrBlank() || !peer.equals(failedPeer, ignoreCase = true)) return true
-        val elapsed = nowMs - failedAtMs
-        return elapsed < 0L || elapsed >= cooldownMs
+        val key = peerKey(peer) ?: return true
+        val failedAt = failedPeers[key] ?: return true
+        if (isCoolingDown(failedAt, nowMs)) return false
+        failedPeers.remove(key)
+        return true
+    }
+
+    private fun peerKey(peer: String?): String? = peer?.trim()?.takeIf { it.isNotEmpty() }?.uppercase(Locale.ROOT)
+
+    private fun isCoolingDown(failedAt: Long, nowMs: Long): Boolean = nowMs >= failedAt && nowMs - failedAt < cooldownMs
+
+    private companion object {
+        const val MAX_TRACKED_PEERS = 16
     }
 }
 
