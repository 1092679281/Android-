+package com.mcarplay.app.video
+
+/** Conservative experimental display policy for the observed GM E2LB family, not a model-year decoder. */
+internal object LacrosseProjectionPolicy {
+    private const val MAX_PIXELS = 2_073_600L
+    private const val MAX_WIDTH = 2560
+    private const val MAX_HEIGHT = 1080
+
+    data class Output(val width: Int, val height: Int, val scalePercent: Int, val fps: Int)
+
+    fun matches(model: String?, manufacturer: String?): Boolean =
+        model.equals("E2LB", ignoreCase = true) && manufacturer.orEmpty().contains("general motors", ignoreCase = true)
+
+    fun reportedGeometry(width: Long?, height: Long?): Boolean =
+        width != null && height != null && width in 1L..8192L && height in 1L..8192L
+
+    /** No guessed panel sizes, upscaling or unsupported aspect ratios. Null means compatibility path. */
+    fun choose(
+        width: Int,
+        height: Int,
+        reported: Boolean,
+        requestedScale: Int,
+        requestedFps: Int,
+        receiverMaxFps: Int,
+    ): Output? {
+        if (!reported || width !in 640..8192 || height !in 360..8192 || width.toDouble() / height !in 1.2..3.5) return null
+        val fps = minOf(30, SourceFpsPolicy.effective(requestedFps, receiverMaxFps))
+        for (scale in requestedScale.coerceIn(30, 100) downTo 1) {
+            val w = (width * scale / 100 / 2) * 2
+            val h = (height * scale / 100 / 2) * 2
+            if (w > MAX_WIDTH || h > MAX_HEIGHT || w.toLong() * h > MAX_PIXELS) continue
+            if (!ProjectedDashboardLayout.supports(w, h)) return null
+            return Output(w, h, scale, fps)
+        }
+        return null
+    }
+
+    /** Budget only the experimental local encoder; passthrough bitrates cannot be controlled here. */
+    fun bitrate(width: Int, height: Int, fps: Int): Int =
+        ProjectionEncoderPolicy.initialBitrate(width, height, fps).coerceAtMost(8_000_000)
+}
