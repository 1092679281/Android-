@@ -0,0 +1,108 @@
+package com.mcarplay.app.video
+
+/** Shared pixel geometry for rendering and single-pointer input. Coordinates are top-left based. */
+internal data class ProjectionRect(val left: Int, val top: Int, val right: Int, val bottom: Int) {
+    val width get() = right - left
+    val height get() = bottom - top
+    fun contains(x: Int, y: Int) = x in left until right && y in top until bottom
+}
+
+internal enum class DashboardAction { PREVIOUS, PLAY_PAUSE, NEXT }
+
+internal class ProjectedDashboardLayout(
+    val width: Int,
+    val height: Int,
+    sourceWidth: Int,
+    sourceHeight: Int,
+    wideReceiver: Boolean = false,
+) {
+    init {
+        require(supports(width, height) && sourceWidth > 0 && sourceHeight > 0)
+    }
+    companion object {
+        fun supports(width: Int, height: Int): Boolean =
+            width >= 640 && height >= 360 && width.toLong() * height <= 3_000_000L &&
+                width.toDouble() / height in 1.2..3.5
+    }
+    private val gap = (height * 0.025).toInt().coerceAtLeast(4)
+    private val railWidth = (height * if (wideReceiver) 0.15 else 0.12).toInt().coerceAtLeast(28)
+    val rail = ProjectionRect(gap, gap, railWidth + gap, height - gap)
+    private val panelLeft = if (wideReceiver) {
+        // Keep media controls readable while reserving more width for the live content on ultra-wide displays.
+        width - gap - minOf((width * 0.28).toInt(), (height * 0.65).toInt())
+    } else (width * 0.72).toInt()
+    val panel = ProjectionRect(panelLeft, gap, width - gap, height - gap)
+    val content = ProjectionRect(rail.right + gap, gap, panel.left - gap, height - gap)
+    val video: ProjectionRect
+    val controls: List<Pair<DashboardAction, ProjectionRect>>
+    init {
+        val inset = gap / 2
+        val area = ProjectionRect(content.left + inset, content.top + inset, content.right - inset, content.bottom - inset)
+        val fit = minOf(area.width.toDouble() / sourceWidth, area.height.toDouble() / sourceHeight)
+        val w = (sourceWidth * fit).toInt().coerceIn(1, area.width)
+        val h = (sourceHeight * fit).toInt().coerceIn(1, area.height)
+        val x = area.left + (area.width - w) / 2
+        val y = area.top + (area.height - h) / 2
+        video = ProjectionRect(x, y, x + w, y + h)
+        val top = panel.top + (panel.height * 0.72).toInt()
+        val bottom = panel.top + (panel.height * 0.90).toInt()
+        controls = DashboardAction.entries.mapIndexed { index, action ->
+            val l = panel.left + panel.width * index / 3
+            val r = panel.left + panel.width * (index + 1) / 3
+            action to ProjectionRect(l, top, r, bottom)
+        }
+    }
+
+    fun displayPoint(x: Int, y: Int, displayWidth: Int, displayHeight: Int): Pair<Int, Int>? {
+        if (displayWidth <= 0 || displayHeight <= 0) return null
+        // Preserve outside coordinates so a dock gesture crossing the boundary is cancelled.
+        fun scale(value: Int, target: Int, source: Int): Int = when {
+            value < 0 -> -1
+            value >= source -> target
+            else -> (value.toLong() * target / source).toInt()
+        }
+        return scale(x, width, displayWidth) to scale(y, height, displayHeight)
+    }
+
+    fun actionAt(x: Int, y: Int): DashboardAction? = controls.firstOrNull { it.second.contains(x, y) }?.first
+    fun sourcePoint(x: Int, y: Int, targetWidth: Int, targetHeight: Int): Pair<Int, Int>? {
+        if (targetWidth <= 0 || targetHeight <= 0) return null
+        return ((x.coerceIn(video.left, video.right - 1) - video.left).toLong() * targetWidth / video.width).toInt() to
+            ((y.coerceIn(video.top, video.bottom - 1) - video.top).toLong() * targetHeight / video.height).toInt()
+    }
+}
+
+/** Capture one gesture on its original target; never forward a dock press as an app touch. */
+internal class DashboardTouchRouter {
+    data class Result(val point: Pair<Int, Int>? = null, val action: DashboardAction? = null, val cancelSource: Boolean = false)
+    private var active = false
+    private var source = false
+    private var action: DashboardAction? = null
+    private var cancelled = false
+    @Synchronized
+    fun reset() {
+        active = false
+        source = false
+        action = null
+        cancelled = false
+    }
+    @Synchronized
+    fun route(layout: ProjectedDashboardLayout, x: Int, y: Int, down: Boolean, targetWidth: Int, targetHeight: Int): Result {
+        if (down && !active) {
+            active = true
+            source = layout.video.contains(x, y)
+            action = layout.actionAt(x, y)
+            cancelled = false
+        }
+        if (!active) return Result()
+        if (source) {
+            val point = layout.sourcePoint(x, y, targetWidth, targetHeight)
+            if (!down) active = false
+            return Result(point = point)
+        }
+        if (layout.actionAt(x, y) != action) cancelled = true
+        if (down) return Result()
+        active = false
+        return Result(action = action.takeUnless { cancelled })
+    }
+}
