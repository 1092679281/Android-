+        val y = p.top + p.height * .66f
+        val available = p.width * .82f
+        paint.color = 0xFF72839E.toInt()
+        canvas.drawRoundRect(x, y, x + available, y + layout.height * .008f, 3f, 3f, paint)
+        if (progress > 0) {
+            paint.color = Color.WHITE
+            canvas.drawRoundRect(x, y, x + progress.coerceAtMost(available.toInt()), y + layout.height * .008f, 3f, 3f, paint)
+        }
+    }
+    fun release() {
+        if (texture != 0) GL.glDeleteTextures(1, intArrayOf(texture), 0)
+        if (program != 0) GL.glDeleteProgram(program)
+        railBitmap?.recycle()
+        panelBitmap?.recycle()
+        progressBitmap?.recycle()
+        railBitmap = null
+        panelBitmap = null
+        progressBitmap = null
+    }
+    private fun compile(type: Int, source: String): Int {
+        val id = GL.glCreateShader(type)
+        GL.glShaderSource(id, source)
+        GL.glCompileShader(id)
+        val ok = IntArray(1)
+        GL.glGetShaderiv(id, GL.GL_COMPILE_STATUS, ok, 0)
+        if (ok[0] == 0) {
+            val message = GL.glGetShaderInfoLog(id)
+            GL.glDeleteShader(id)
+            error(message)
+        }
+        return id
+    }
+    private fun buffer(vararg values: Float) = ByteBuffer.allocateDirect(values.size * 4).order(ByteOrder.nativeOrder()).asFloatBuffer().apply { put(values); position(0) }
+}
