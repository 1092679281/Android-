@@ -0,0 +1,64 @@
+package com.mcarplay.app.video
+
+/** GL-thread-only output budget. A late render never schedules a catch-up burst. */
+internal class ProjectionFramePacer(fps: Int) {
+    val intervalNs = (1_000_000_000L + fps.coerceIn(1, 120) - 1) / fps.coerceIn(1, 120)
+    private var nextAllowedNs: Long? = null
+    var sourcePending = false
+        private set
+    var coalesced = 0L
+        private set
+
+    fun sourceArrived() {
+        if (sourcePending) coalesced++
+        sourcePending = true
+    }
+
+    fun delayMs(nowNs: Long): Long {
+        val remaining = ((nextAllowedNs ?: nowNs) - nowNs).coerceAtLeast(0L)
+        return (remaining + 999_999L) / 1_000_000L
+    }
+
+    fun rendered(startNs: Long) {
+        sourcePending = false
+        nextAllowedNs = startNs + intervalNs
+    }
+}
+
+/** Only visible changes require a texture upload. Album art identity is checked by the caller. */
+internal data class DashboardVisualKey(
+    val clock: String,
+    val date: String,
+    val title: String?,
+    val artist: String?,
+    val playing: Boolean,
+    val hasAccess: Boolean,
+    val progressPixels: Int,
+    val art: Any?,
+) {
+    fun changesFrom(old: DashboardVisualKey?): DashboardDirty {
+        if (old == null) return DashboardDirty(true, true, true)
+        val panel = date != old.date || title != old.title || artist != old.artist || playing != old.playing ||
+            hasAccess != old.hasAccess || art !== old.art
+        return DashboardDirty(clock != old.clock, panel, !panel && progressPixels != old.progressPixels)
+    }
+}
+
+internal data class DashboardDirty(val rail: Boolean, val panel: Boolean, val progress: Boolean) {
+    val any get() = rail || panel || progress
+}
+
+/** Preserve the established bitrate budget; do not force an impossible AVC level at high FPS. */
+internal object ProjectionEncoderPolicy {
+    fun initialBitrate(width: Int, height: Int, fps: Int): Int {
+        val pixels = (width.toLong() * height).coerceIn(0L, 10_000_000L)
+        val base = (pixels * 6L).coerceIn(2_000_000L, 10_000_000L)
+        return (if (fps >= 60) base * 3 / 2 else base).coerceAtMost(15_000_000L).toInt()
+    }
+
+    fun fitsAvcLevel4(width: Int, height: Int, fps: Int): Boolean {
+        if (width <= 0 || height <= 0 || fps <= 0) return false
+        val blocks = ((width.toLong() + 15) / 16) * ((height.toLong() + 15) / 16)
+        return blocks <= 8192 && blocks * fps <= 245760 && initialBitrate(width, height, fps) <= 20_000_000
+    }
+}
