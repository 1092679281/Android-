index 0000000..2f3b911
--- /dev/null
+++ b/app/src/test/java/com/mcarplay/app/video/ProjectedDashboardLayoutTest.kt
@@ -0,0 +1,69 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ProjectedDashboardLayoutTest {
+    private val layout = ProjectedDashboardLayout(1280, 720, 1920, 1140)
+    @Test fun layoutFitsCommonDisplays() {
+        for ((w, h) in listOf(640 to 360, 800 to 480, 1024 to 600, 1280 to 720, 1920 to 1080, 2560 to 720)) {
+            if (!ProjectedDashboardLayout.supports(w, h)) continue
+            val l = ProjectedDashboardLayout(w, h, 1920, 1140)
+            assertTrue(l.video.width > 0 && l.video.height > 0)
+            assertTrue(l.video.left >= l.content.left && l.video.right <= l.content.right)
+            assertTrue(l.video.top >= l.content.top && l.video.bottom <= l.content.bottom)
+            assertTrue(l.video.right < l.panel.left)
+            assertEquals(3, l.controls.size)
+            assertTrue(l.controls.all { it.second.width > 0 && it.second.height > 0 })
+        }
+    }
+    @Test fun unsafeDimensionsFallBack() {
+        for ((w, h) in listOf(320 to 180, 720 to 1280, 4096 to 2160, 1280 to 0, 2560 to 540)) {
+            assertFalse(ProjectedDashboardLayout.supports(w, h))
+        }
+    }
+    @Test fun sourceTouchCapturesAndClampsDrag() {
+        val router = DashboardTouchRouter()
+        val v = layout.video
+        val begin = router.route(layout, v.left, v.top, true, 1920, 1140)
+        assertEquals(0 to 0, begin.point)
+        val move = router.route(layout, layout.width + 100, layout.height + 100, true, 1920, 1140)
+        assertNotNull(move.point)
+        assertNull(move.action)
+        val up = router.route(layout, layout.width + 100, layout.height + 100, false, 1920, 1140)
+        assertEquals(move.point, up.point)
+        assertNull(router.route(layout, v.left, v.top, false, 1920, 1140).point)
+    }
+    @Test fun mediaButtonOnlyFiresOnMatchingRelease() {
+        val router = DashboardTouchRouter()
+        val (action, r) = layout.controls[1]
+        assertNull(router.route(layout, r.left, r.top, true, 1920, 1140).action)
+        assertEquals(action, router.route(layout, r.left, r.top, false, 1920, 1140).action)
+        assertNull(router.route(layout, r.left, r.top, false, 1920, 1140).action)
+        router.route(layout, r.left, r.top, true, 1920, 1140)
+        assertNull(router.route(layout, layout.video.left, layout.video.top, true, 1920, 1140).point)
+        assertNull(router.route(layout, r.left, r.top, false, 1920, 1140).action)
+    }
+    @Test fun backgroundCannotBeginSourceGesture() {
+        val router = DashboardTouchRouter()
+        router.route(layout, 0, 0, true, 1920, 1140)
+        assertNull(router.route(layout, layout.video.left, layout.video.top, true, 1920, 1140).point)
+        assertNull(router.route(layout, layout.video.left, layout.video.top, false, 1920, 1140).point)
+    }
+    @Test fun displayScalingPreservesOutside() {
+        assertEquals(640 to 360, layout.displayPoint(960, 540, 1920, 1080))
+        assertEquals(-1 to 720, layout.displayPoint(-1, 1080, 1920, 1080))
+        assertNull(layout.displayPoint(1, 1, 0, 1080))
+    }
+    @Test fun resetDoesNotEmitMediaAction() {
+        val router = DashboardTouchRouter()
+        val r = layout.controls[0].second
+        router.route(layout, r.left, r.top, true, 1920, 1140)
+        router.reset()
+        assertNull(router.route(layout, r.left, r.top, false, 1920, 1140).action)
+    }
+}
