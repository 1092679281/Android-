@@ -0,0 +1,58 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ProjectionFramePacerTest {
+    @Test
+    fun burstCoalescesWithoutCatchUp() {
+        val pacer = ProjectionFramePacer(60)
+        repeat(10) { pacer.sourceArrived() }
+        assertEquals(9L, pacer.coalesced)
+        assertEquals(0L, pacer.delayMs(0L))
+        pacer.rendered(0L)
+        assertFalse(pacer.sourcePending)
+        assertEquals(17L, pacer.delayMs(0L))
+        assertEquals(1L, pacer.delayMs(16_666_666L))
+        assertEquals(0L, pacer.delayMs(16_666_667L))
+        pacer.rendered(2_000_000_000L)
+        assertEquals(17L, pacer.delayMs(2_000_000_000L))
+    }
+
+    @Test
+    fun receiverRateCapsTheBudget() {
+        for (fps in listOf(15, 24, 30, 40, 60, 120)) {
+            val pacer = ProjectionFramePacer(fps)
+            val interval = pacer.intervalNs
+            assertTrue(interval * fps >= 1_000_000_000L)
+            pacer.rendered(100L)
+            assertEquals(1L, pacer.delayMs(100L + interval - 1L))
+            assertEquals(0L, pacer.delayMs(100L + interval))
+        }
+    }
+
+    @Test
+    fun unchangedMediaDoesNotUploadTexture() {
+        val art = Any()
+        val a = DashboardVisualKey("10:01", "Wed", "Title", "Artist", true, true, 15, art)
+        assertFalse(a.copy().changesFrom(a).any)
+        assertEquals(DashboardDirty(true, false, false), a.copy(clock = "10:02").changesFrom(a))
+        assertEquals(DashboardDirty(false, false, true), a.copy(progressPixels = 16).changesFrom(a))
+        assertEquals(DashboardDirty(false, true, false), a.copy(playing = false).changesFrom(a))
+        assertEquals(DashboardDirty(false, true, false), a.copy(art = Any()).changesFrom(a))
+        assertEquals(DashboardDirty(true, true, false), a.copy(clock = "10:02", date = "Thu").changesFrom(a))
+        assertTrue(a.changesFrom(null).any)
+    }
+
+    @Test
+    fun bitrateAndAvcLevelRespectLimits() {
+        assertTrue(ProjectionEncoderPolicy.fitsAvcLevel4(1280, 720, 60))
+        assertTrue(ProjectionEncoderPolicy.fitsAvcLevel4(1920, 1080, 30))
+        assertFalse(ProjectionEncoderPolicy.fitsAvcLevel4(1920, 1080, 60))
+        assertFalse(ProjectionEncoderPolicy.fitsAvcLevel4(3840, 2160, 30))
+        assertEquals(10_000_000, ProjectionEncoderPolicy.initialBitrate(1920, 1080, 30))
+        assertEquals(15_000_000, ProjectionEncoderPolicy.initialBitrate(1920, 1080, 60))
+    }
+}
