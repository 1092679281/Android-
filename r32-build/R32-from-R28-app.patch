@@ -0,0 +1,31 @@
+package com.mcarplay.app.video
+
+import java.nio.ByteBuffer
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ProjectionRecoveryPolicyTest {
+    @Test
+    fun cooldownIsLimitedToFailedPeerAndExpires() {
+        val policy = ProjectionRecoveryPolicy()
+        policy.recordLocalFailure("AA", 100L)
+        assertFalse(policy.allowsDashboard("aa", 600099L))
+        assertTrue(policy.allowsDashboard("AA", 600100L))
+        assertTrue(policy.allowsDashboard("BB", 101L))
+        assertTrue(policy.allowsDashboard(null, 101L))
+    }
+
+    @Test
+    fun codecWindowUsesOffsetAndDoesNotMutateOriginal() {
+        val buffer = ByteBuffer.wrap(byteArrayOf(0, 1, 2, 3, 4))
+        buffer.position(1)
+        val view = requireNotNull(codecOutputWindow(buffer, 2, 2))
+        assertArrayEquals(byteArrayOf(2, 3), ByteArray(view.remaining()).also(view::get))
+        assertTrue(buffer.position() == 1 && buffer.limit() == 5)
+        assertNull(codecOutputWindow(buffer, Int.MAX_VALUE, Int.MAX_VALUE))
+        assertNull(codecOutputWindow(buffer, -1, 2))
+    }
+}
