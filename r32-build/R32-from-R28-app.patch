+
+    /** Poll at most four times a second; the independent GL tick also uses this path. */
+    fun hasVisualChange(nowMs: Long): Boolean {
+        if (lastPoll < 0 || nowMs - lastPoll >= 250) {
+            lastPoll = nowMs
+            pendingSnapshot = snapshot()
+        }
+        return pendingSnapshot?.key?.changesFrom(lastKey)?.any == true
+    }
