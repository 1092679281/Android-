@@ -0,0 +1,41 @@
+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class LacrosseProjectionPolicyTest {
+    @Test fun identityIsConservative() {
+        assertTrue(LacrosseProjectionPolicy.matches("e2lb", "General Motors"))
+        assertFalse(LacrosseProjectionPolicy.matches("E2LB", "unknown"))
+        assertFalse(LacrosseProjectionPolicy.matches("other", "General Motors"))
+    }
+    @Test fun explicitGeometryIsRequired() {
+        assertFalse(LacrosseProjectionPolicy.reportedGeometry(null, 720L))
+        assertFalse(LacrosseProjectionPolicy.reportedGeometry(Long.MAX_VALUE, 720L))
+        assertTrue(LacrosseProjectionPolicy.reportedGeometry(1280L, 720L))
+        assertNull(LacrosseProjectionPolicy.choose(1280, 720, false, 100, 60, 60))
+        assertNull(LacrosseProjectionPolicy.choose(6008, 934, true, 100, 60, 60))
+    }
+    @Test fun noUpscalingAndCapFps() {
+        assertEquals(LacrosseProjectionPolicy.Output(1280, 720, 100, 30), LacrosseProjectionPolicy.choose(1280, 720, true, 160, 60, 60))
+        assertEquals(24, LacrosseProjectionPolicy.choose(1920, 1080, true, 100, 60, 24)?.fps)
+    }
+    @Test fun largeSurfacesAreBounded() {
+        val p = requireNotNull(LacrosseProjectionPolicy.choose(3840, 2160, true, 100, 60, 60))
+        assertEquals(1920, p.width)
+        assertEquals(1080, p.height)
+        assertEquals(50, p.scalePercent)
+        assertTrue(LacrosseProjectionPolicy.bitrate(p.width, p.height, p.fps) <= 8_000_000)
+    }
+    @Test fun wideLayoutUsesSharedTouchGeometry() {
+        val l = ProjectedDashboardLayout(2400, 800, 1920, 1080, true)
+        val standard = ProjectedDashboardLayout(2400, 800, 1920, 1080)
+        assertTrue(l.content.width > standard.content.width)
+        assertEquals(0 to 0, l.sourcePoint(l.video.left, l.video.top, 1920, 1080))
+        assertTrue(l.video.right < l.panel.left)
+        assertTrue(l.controls.all { it.second.width > 0 && it.second.height > 0 })
+    }
+}
diff --git a/app/src/test/java/com/mcarplay/app/video/ProjectedDashboardLayoutTest.kt b/app/src/test/java/com/mcarplay/app/video/ProjectedDashboardLayoutTest.kt
