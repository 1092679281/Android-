+
+/** GL-thread-only background compositor. Source video is drawn over its allocated rectangle. */
+internal class ProjectedDashboardRenderer(private val layout: ProjectedDashboardLayout) {
+    private var program = 0
+    private var texture = 0
+    private var lastKey: DashboardVisualKey? = null
+    private var pendingSnapshot: Snapshot? = null
+    private var lastPoll = -1L
+    private lateinit var canvas: Canvas
+    private var railBitmap: Bitmap? = null
+    private var panelBitmap: Bitmap? = null
+    private var progressBitmap: Bitmap? = null
+    private var p = -1
+    private var t = -1
+    private var sampler = -1
+    var uploadedPixels = 0L
+        private set
+    var textureUpdates = 0L
+        private set
+    private data class Snapshot(val key: DashboardVisualKey, val now: MediaSessionsState.NowPlaying?)
+    // Include the antialiased edges of the progress track, without touching title/controls.
+    private val progressBounds = layout.panel.let { r ->
+        val x = r.left + r.width * .09f
+        val y = r.top + r.height * .66f
+        ProjectionRect((x - 2).toInt(), (y - 2).toInt(),
+            kotlin.math.ceil(x + r.width * .82f + 2).toInt(),
+            kotlin.math.ceil(y + layout.height * .008f + 2).toInt())
+    }
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG)
+    private val positions = buffer(-1f, -1f, 1f, -1f, -1f, 1f, 1f, 1f)
+    private val uv = buffer(0f, 1f, 1f, 1f, 0f, 0f, 1f, 0f)
+    private val chinese = Locale.getDefault().language == "zh"
+    private val clock = SimpleDateFormat("HH:mm", Locale.getDefault())
+    private val date = SimpleDateFormat("EEE, MMM d", Locale.getDefault())
+
+    fun start() {
+        val maximum = IntArray(1)
+        GL.glGetIntegerv(GL.GL_MAX_TEXTURE_SIZE, maximum, 0)
+        check(layout.width <= maximum[0] && layout.height <= maximum[0]) { "dashboard texture exceeds GL limit" }
+        val vs = compile(GL.GL_VERTEX_SHADER, "attribute vec2 p; attribute vec2 t; varying vec2 v; void main(){gl_Position=vec4(p,0.,1.);v=t;}")
+        var fs = 0
+        try {
+            fs = compile(GL.GL_FRAGMENT_SHADER, "precision mediump float; varying vec2 v; uniform sampler2D s; void main(){gl_FragColor=texture2D(s,v);}")
+            program = GL.glCreateProgram()
+            GL.glAttachShader(program, vs)
+            GL.glAttachShader(program, fs)
+            GL.glLinkProgram(program)
+            val status = IntArray(1)
+            GL.glGetProgramiv(program, GL.GL_LINK_STATUS, status, 0)
+            check(status[0] != 0) { GL.glGetProgramInfoLog(program) }
+        } finally {
+            GL.glDeleteShader(vs)
+            if (fs != 0) GL.glDeleteShader(fs)
+        }
+        val ids = IntArray(1)
+        GL.glGenTextures(1, ids, 0)
+        texture = ids[0]
+        check(texture != 0)
+        GL.glBindTexture(GL.GL_TEXTURE_2D, texture)
+        GL.glTexParameteri(GL.GL_TEXTURE_2D, GL.GL_TEXTURE_MIN_FILTER, GL.GL_LINEAR)
+        GL.glTexParameteri(GL.GL_TEXTURE_2D, GL.GL_TEXTURE_MAG_FILTER, GL.GL_LINEAR)
+        GL.glTexParameteri(GL.GL_TEXTURE_2D, GL.GL_TEXTURE_WRAP_S, GL.GL_CLAMP_TO_EDGE)
+        GL.glTexParameteri(GL.GL_TEXTURE_2D, GL.GL_TEXTURE_WRAP_T, GL.GL_CLAMP_TO_EDGE)
+        p = GL.glGetAttribLocation(program, "p")
+        t = GL.glGetAttribLocation(program, "t")
+        sampler = GL.glGetUniformLocation(program, "s")
+        val initial = snapshot()
+        val full = Bitmap.createBitmap(layout.width, layout.height, Bitmap.Config.ARGB_8888)
+        try {
+            canvas = Canvas(full)
+            renderBase()
+            renderRail(initial)
+            renderPanel(initial)
+            GLUtils.texImage2D(GL.GL_TEXTURE_2D, 0, full, 0)
+            check(GL.glGetError() == GL.GL_NO_ERROR) { "dashboard initial upload failed" }
