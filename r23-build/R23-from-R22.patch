+    @Test
+    fun invalidAcknowledgementsNeverRemoveUnsentOrUnconfirmedPackets() {
+        val phone = normalHandshake().phone
+        fun field(name: String): Any? = phone.javaClass.getDeclaredField(name).apply { isAccessible = true }.get(phone)
+        fun outstanding(): Int = (field("unacknowledged") as List<*>).size
+        fun watermark(): Int = field("lastSentAcknowledged") as Int
+        fun ack(sequence: Int) = ackFrame().apply {
+            this[6] = sequence.toByte()
+            this[8] = (-take(8).sumOf { it.toInt() and 255 }).toByte()
+        }
+        val initial = watermark()
+        repeat(20) { assertTrue(phone.sendControl(Iap2Csm.encode(0x5000), tick())) }
+        val lastSent = field("sentSequence") as Int
+        phone.takeOutput()
+        assertEquals(20, outstanding())
+        phone.feed(ack(initial), tick())
+        phone.feed(ack((lastSent + 1) and 255), tick())
+        phone.feed(ack((initial - 1) and 255), tick())
+        assertEquals(20, outstanding())
+        assertEquals(initial, watermark())
+        phone.feed(ack(lastSent), tick())
+        assertEquals(0, outstanding())
+        assertEquals(lastSent, watermark())
+    }
