+    /** Bound transfer size and decoded bitmap allocation before reading external artwork. */
+    private fun decodeArtwork(uri: String): android.graphics.Bitmap? {
+        val parsed = android.net.Uri.parse(uri)
+        val input = when (parsed.scheme?.lowercase(java.util.Locale.ROOT)) {
+            "http", "https" -> java.net.URL(uri).openConnection().apply {
+                connectTimeout = 3_000
+                readTimeout = 3_000
+            }.getInputStream()
+            "content", "android.resource" -> contentResolver.openInputStream(parsed)
+            else -> null
+        } ?: return null
+        val bytes = input.use { stream ->
+            val out = java.io.ByteArrayOutputStream()
+            val buffer = ByteArray(8192)
+            val started = android.os.SystemClock.elapsedRealtime()
+            while (true) {
+                if (Thread.currentThread().isInterrupted || android.os.SystemClock.elapsedRealtime() - started > 8_000L) return null
+                val count = stream.read(buffer)
+                if (count < 0) break
+                if (count == 0) return null
+                if (!ProjectionArtworkBudget.acceptsBytes(out.size(), count)) return null
+                out.write(buffer, 0, count)
+            }
+            out.toByteArray()
+        }
+        val options = android.graphics.BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        android.graphics.BitmapFactory.decodeByteArray(bytes, 0, bytes.size, options)
+        options.inSampleSize = ProjectionArtworkBudget.sampleSize(options.outWidth, options.outHeight) ?: return null
+        options.inJustDecodeBounds = false
+        val decoded = android.graphics.BitmapFactory.decodeByteArray(bytes, 0, bytes.size, options) ?: return null
+        val scaled = runCatching { scaleArt(decoded) }.getOrElse {
+            decoded.recycle()
+            return null
+        }
+        if (scaled !== decoded) decoded.recycle()
+        return scaled
+    }
