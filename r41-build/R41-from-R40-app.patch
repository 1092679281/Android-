+package com.mcarplay.app.video
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class ProjectionAppearancePolicyTest {
+    @Test
+    fun systemThemeOverridesClockWithFallback() {
+        for (hour in -2..26) {
+            assertTrue(ProjectionThemePolicy.isNight(true, hour))
+            assertFalse(ProjectionThemePolicy.isNight(false, hour))
+            assertEquals(hour !in 6..17, ProjectionThemePolicy.isNight(null, hour))
+        }
+    }
+
+    @Test
+    fun oldArtworkCannotReturnAfterABAOrDisconnect() {
+        val gate = ProjectionArtworkGate<String>()
+        assertTrue(gate.select("A"))
+        val a = gate.issue()
+        assertFalse(gate.select("A"))
+        assertTrue(gate.accepts(a))
+        gate.select("B")
+        val b = gate.issue()
+        gate.select("A")
+        val current = gate.issue()
+        assertFalse(gate.accepts(a))
+        assertFalse(gate.accepts(b))
+        assertTrue(gate.accepts(current))
+        gate.clear()
+        assertFalse(gate.accepts(current))
+        gate.select("A")
+        assertFalse(gate.accepts(current))
+    }
+
+    @Test
+    fun randomArtworkCompletionsOnlyAcceptLatestLiveTicket() {
+        val random = Random(41)
+        val gate = ProjectionArtworkGate<Int>()
+        val old = mutableListOf<Long>()
+        var current: Long? = null
+        var key: Int? = null
+        repeat(10000) {
+            when (random.nextInt(4)) {
+                0 -> {
+                    gate.clear()
+                    key = null
+                    current = null
+                }
+                1 -> {
+                    val next = random.nextInt(4)
+                    assertEquals(key != next, gate.select(next))
+                    if (key != next) current = null
+                    key = next
+                }
+                2 -> if (key != null) {
+                    val ticket = gate.issue()
+                    current = ticket
+                    old.add(ticket)
+                }
+                3 -> Unit
+            }
+            if (old.isNotEmpty()) {
+                val ticket = old.random(random)
+                assertEquals(ticket == current, gate.accepts(ticket))
+            }
+            current?.let { assertTrue(gate.accepts(it)) }
+        }
+        println("Random artwork lifecycle steps: 10000")
+    }
+
+    @Test
+    fun decodeBudgetRejectsInvalidAndOversizedHeaders() {
+        for (side in listOf(Int.MIN_VALUE, 0, -1, 32769, Int.MAX_VALUE)) {
+            assertNull(ProjectionArtworkBudget.sampleSize(side, 1))
+        }
+        assertEquals(1, ProjectionArtworkBudget.sampleSize(512, 1))
+        assertEquals(2, ProjectionArtworkBudget.sampleSize(513, 1))
+        assertEquals(64, ProjectionArtworkBudget.sampleSize(32768, 1))
+        val random = Random(410)
+        repeat(10000) {
+            val w = random.nextInt(1, 32769)
+            val h = random.nextInt(1, 32769)
+            val sample = requireNotNull(ProjectionArtworkBudget.sampleSize(w, h))
+            assertTrue(sample > 0 && (sample and (sample - 1)) == 0)
+            assertTrue((maxOf(w, h) + sample - 1) / sample <= 512)
+        }
+        assertTrue(ProjectionArtworkBudget.acceptsBytes(ProjectionArtworkBudget.MAX_BYTES - 1, 1))
+        assertFalse(ProjectionArtworkBudget.acceptsBytes(ProjectionArtworkBudget.MAX_BYTES, 1))
+        assertFalse(ProjectionArtworkBudget.acceptsBytes(-1, 1))
+        assertFalse(ProjectionArtworkBudget.acceptsBytes(1, Int.MAX_VALUE))
+        println("Random artwork decode budget configurations: 10000")
+    }
+}
