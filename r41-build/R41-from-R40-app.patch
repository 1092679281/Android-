diff --git a/app/src/main/java/com/mcarplay/app/video/ProjectionAppearancePolicy.kt b/app/src/main/java/com/mcarplay/app/video/ProjectionAppearancePolicy.kt
new file mode 100644
index 0000000..d8dcce7
--- /dev/null
+++ b/app/src/main/java/com/mcarplay/app/video/ProjectionAppearancePolicy.kt
@@ -0,0 +1,49 @@
+package com.mcarplay.app.video
+
+/** Prefer the phone's configured theme; clock fallback is used only when it is unavailable. */
+internal object ProjectionThemePolicy {
+    fun isNight(systemNight: Boolean?, hour: Int): Boolean = systemNight ?: (hour !in 6..17)
+}
+
+/** Main-thread-only. A-B-A metadata changes and retries must not accept a stale completion. */
+internal class ProjectionArtworkGate<K : Any> {
+    private var key: K? = null
+    private var generation = 0L
+
+    fun select(next: K): Boolean {
+        if (key == next) return false
+        key = next
+        generation++
+        return true
+    }
+
+    fun issue(): Long {
+        check(key != null)
+        return ++generation
+    }
+
+    fun accepts(ticket: Long): Boolean = key != null && generation == ticket
+
+    fun clear() {
+        key = null
+        generation++
+    }
+}
+
+/** Artwork allocation limits are checked before full decoding. */
+internal object ProjectionArtworkBudget {
+    const val MAX_BYTES = 8 * 1024 * 1024
+    const val MAX_DIMENSION = 32768
+    const val MAX_OUTPUT = 512
+
+    fun sampleSize(width: Int, height: Int): Int? {
+        if (width !in 1..MAX_DIMENSION || height !in 1..MAX_DIMENSION) return null
+        val side = maxOf(width, height)
+        var sample = 1
+        while ((side + sample - 1) / sample > MAX_OUTPUT) sample *= 2
+        return sample
+    }
+
+    fun acceptsBytes(current: Int, next: Int): Boolean =
+        current in 0..MAX_BYTES && next in 0..(MAX_BYTES - current)
+}
