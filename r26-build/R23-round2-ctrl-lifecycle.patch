+package com.mcarplay.app.net
+
+/** A complete bounded HTTP request, not proof of receiver identity. */
+internal object CtrlRequest {
+    fun isComplete(head: String): Boolean = head.endsWith("\r\n\r\n")
+
+    fun isInvite(head: String): Boolean {
+        if (!isComplete(head)) return false
+        val parts = head.substringBefore("\r\n").split(' ')
+        return parts.size == 3 && parts[0] == "GET" &&
+            parts[1].substringBefore('?') == "/ctrl-int/1/connect" &&
+            parts[2] in setOf("HTTP/1.0", "HTTP/1.1")
+    }
+}
+
+/** Atomic invitation observations; reset invalidates clients accepted in older epochs. */
+internal class CtrlInviteEpoch {
+    data class Snapshot(val generation: Long, val count: Int, val receivedAtMillis: Long)
+
+    @Volatile
+    var snapshot = Snapshot(0L, 0, 0L)
+        private set
+
+    @Synchronized
+    fun reset() {
+        snapshot = Snapshot(snapshot.generation + 1L, 0, 0L)
+    }
+
+    @Synchronized
+    fun record(generation: Long, receivedAtMillis: Long): Snapshot? {
+        val current = snapshot
+        if (generation != current.generation || receivedAtMillis <= 0L ||
+            receivedAtMillis < current.receivedAtMillis
+        ) return null
+        return current.copy(count = current.count + 1, receivedAtMillis = receivedAtMillis).also { snapshot = it }
+    }
+}
