+package com.mcarplay.app.net
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CtrlRequestTest {
+    @Test
+    fun incompleteHeaderCannotBecomeInvite() {
+        assertFalse(CtrlRequest.isInvite("GET /ctrl-int/1/connect HTTP/1.1\r\n"))
+        assertFalse(CtrlRequest.isInvite("GET /ctrl-int/1/connect HTTP/1.1\r\nHost: peer"))
+    }
+
+    @Test
+    fun exactRouteAndSupportedHttpVersion() {
+        assertTrue(CtrlRequest.isInvite("GET /ctrl-int/1/connect HTTP/1.1\r\nHost: peer\r\n\r\n"))
+        assertTrue(CtrlRequest.isInvite("GET /ctrl-int/1/connect?q=1 HTTP/1.0\r\n\r\n"))
+        assertFalse(CtrlRequest.isInvite("GET /ctrl-int/1/connect-extra HTTP/1.1\r\n\r\n"))
+        assertFalse(CtrlRequest.isInvite("GET /ctrl-int/1/connect HTTP/fake\r\n\r\n"))
+    }
+
+    @Test
+    fun resetRejectsOldWorkerAndKeepsAtomicSnapshot() {
+        val epoch = CtrlInviteEpoch()
+        val old = epoch.snapshot.generation
+        assertEquals(1, epoch.record(old, 100L)?.count)
+        epoch.reset()
+        assertEquals(null, epoch.record(old, 200L))
+        val current = epoch.snapshot.generation
+        assertEquals(0, epoch.snapshot.count)
+        assertEquals(1, epoch.record(current, 300L)?.count)
+        assertEquals(null, epoch.record(current, 299L))
+        assertEquals(300L, epoch.snapshot.receivedAtMillis)
+    }
+
+    @Test
+    fun futureAndExpiredInvitesAreNotFresh() {
+        assertFalse(CtrlInviteGate.isFresh(1001L, 1000L))
+        assertFalse(CtrlInviteGate.isFresh(1000L, 21001L))
+        assertTrue(CtrlInviteGate.isFresh(1000L, 21000L))
+    }
+}
