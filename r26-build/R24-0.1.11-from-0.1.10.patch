+        after: Iap2LinkEngine.ParserStats,
+        receipt: Iap2LinkEngine.ControlReceipt.State?,
+        alive: Boolean,
+        startSessionReceived: Boolean,
+    ): State {
+        if (!alive) return State.LINK_ENDED
+        if (startSessionReceived) return State.START_SESSION
