+            afterFrames == beforeFrames && after.detectMarkers - before.detectMarkers >= 3 &&
+            after.invalidHeaderChecksums == before.invalidHeaderChecksums &&
+            after.invalidPayloadChecksums == before.invalidPayloadChecksums &&
+            after.invalidLengths == before.invalidLengths && after.discardedNoiseBytes == before.discardedNoiseBytes
