+        assertTrue(phone.takeOutput().isEmpty())
+        phone.feed(ackFor(first[1].sequence), tick())
+        val next = parseFrames(phone.takeOutput())
+        assertEquals(2, next.size)
+        assertEquals((first.last().sequence + 1) and 255, next.first().sequence)
+        phone.feed(ackFor(next.last().sequence), tick())
+        assertTrue(phone.takeOutput().isEmpty())
+    }
