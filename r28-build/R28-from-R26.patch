+
+/** Floating navigation. The lens slides between actual child bounds, including RTL and rotation. */
+class GlassDock
+    @JvmOverloads
+    constructor(
+        context: Context,
+        attrs: AttributeSet? = null,
+    ) : LinearLayout(context, attrs) {
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val lens = RectF()
+        private var selectedIndex = 0
+        private var motion: ValueAnimator? = null
+        private var tint = -1
+        private val targetBounds = RectF()
+
+        init {
+            setWillNotDraw(false)
+            clipToPadding = false
+            setGlassTint(65)
+        }
+
+        fun setGlassTint(value: Int) {
+            val next = value.coerceIn(0, 100)
+            if (tint == next) return
+            tint = next
+            val solid = context.getColor(R.color.ui_card)
+            val surface = context.getColor(R.color.ui_glass_surface)
+            val light = ColorUtils.blendARGB(surface, solid, tint / 100f)
+            val shade = ColorUtils.blendARGB(context.getColor(R.color.ui_glass_shade), solid, tint / 100f)
