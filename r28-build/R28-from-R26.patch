+#!/usr/bin/env python3
+"""Offline structural and contrast checks. Not a replacement for Android resource compilation."""
+import re
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from zipfile import ZipFile
+
+ROOT = Path(__file__).resolve().parents[1]
+RES = ROOT / 'app/src/main/res'
+ANDROID = '{http://schemas.android.com/apk/res/android}'
+
+
+def tokens(mode):
+    return {e.attrib['name']: e.text for e in ET.parse(RES / mode / 'colors_ui.xml').getroot()}
+
+
+def rgba(value):
+    value = value.lstrip('#')
+    a = int(value[:2], 16) / 255 if len(value) == 8 else 1
+    return tuple(int(value[-6:][i:i + 2], 16) / 255 for i in (0, 2, 4)) + (a,)
+
+
+def over(color, background):
+    return tuple(a * color[3] + b * (1 - color[3]) for a, b in zip(color[:3], background[:3])) + (1,)
+
+
+def luminance(c):
+    return sum((v / 12.92 if v <= .03928 else ((v + .055) / 1.055) ** 2.4) * w
+               for v, w in zip(c, (.2126, .7152, .0722)))
+
+
+def contrast(a, b):
+    x, y = sorted((luminance(a), luminance(b)))
+    return (y + .05) / (x + .05)
+
+
+def check_colors(mode):
+    c = {k: rgba(v) for k, v in tokens(mode).items()}
+    pairs = [('ui_text', 'ui_bg'), ('ui_text', 'ui_card'), ('ui_text_secondary', 'ui_bg'),
+             ('ui_text_secondary', 'ui_card'), ('ui_accent_text', 'ui_card'), ('ui_ok_text', 'ui_card'),
+             ('ui_error_text', 'ui_card'), ('ui_on_accent', 'ui_accent_fill'), ('ui_warn_text', 'ui_card'),
+             ('ui_text_secondary', 'ui_field'), ('ui_text_secondary', 'ui_canvas_end'),
+             ('ui_text_secondary', 'ui_hero_end')]
+    checks = [(a + '/' + b, contrast(c[a], c[b])) for a, b in pairs]
+    for a, b, under in [('ui_accent_text', 'ui_accent_tint', 'ui_bg'), ('ui_error_text', 'ui_error_tint', 'ui_bg'),
+                        ('ui_ok_text', 'ui_ok_tint', 'ui_card'), ('ui_warn_text', 'ui_warn_tint', 'ui_card')]:
+        checks.append((a + '/' + b, contrast(c[a], over(c[b], c[under]))))
+    for tint in range(101):
+        f = tint / 100
+        for surface in ('ui_glass_surface', 'ui_glass_shade'):
+            mixed = tuple(a * (1 - f) + b * f for a, b in zip(c[surface], c['ui_card']))
+            for underlying in ('ui_bg', 'ui_canvas_end'):
+                bg = over(mixed, c[underlying])
+                checks.append((f'dock/{surface}/{underlying}/{tint}', contrast(c['ui_dock_text'], bg)))
+                selected = over(c['ui_glass_selection'], bg)
+                checks.append((f'selected/{surface}/{underlying}/{tint}', contrast(c['ui_dock_selected_text'], selected)))
+    worst = min(checks, key=lambda p: p[1])
+    assert worst[1] >= 4.5, (mode, worst)
+    print(f'{mode}: {len(checks)} contrast checks, minimum {worst[1]:.2f}:1 ({worst[0]})')
+
+
+def ids(tree):
+    return {e.attrib[ANDROID + 'id'].split('/')[-1]: e.tag for e in tree.iter() if ANDROID + 'id' in e.attrib}
+
+
+def main():
+    xml = list(RES.rglob('*.xml'))
+    for f in xml:
+        ET.parse(f)
+    print(f'{len(xml)} resource XML files are well formed')
+    assert tokens('values').keys() == tokens('values-night').keys()
+    check_colors('values')
+    check_colors('values-night')
+    layouts = list((RES / 'layout').glob('*.xml'))
+    main = ET.parse(RES / 'layout/activity_main.xml').getroot()
+    dock = next(e for e in main.iter() if e.attrib.get(ANDROID+'id') == '@+id/glassDock')
+    assert [e.attrib[ANDROID+'id'] for e in dock] == ['@+id/tabConnect', '@+id/tabSettings', '@+id/tabDiagnostics']
+    assert {'glassTintSlider', 'glassTintLabel', 'glassDock'} <= ids(main).keys()
+    if len(sys.argv) > 1:
+        with ZipFile(sys.argv[1]) as archive:
+            names = set(archive.namelist())
+            for f in layouts:
+                name = 'mcarplay-project/' + f.relative_to(ROOT).as_posix()
+                if name not in names:
+                    continue
+                old, new = ids(ET.fromstring(archive.read(name))), ids(ET.parse(f).getroot())
+                assert old.keys() <= new.keys(), (f.name, old.keys() - new.keys())
+                for key in old:
+                    if key != 'tabBar':
+                        assert old[key] == new[key], (f.name, key, old[key], new[key])
+            java = ROOT / 'app/src/main/java/com/mcarplay/app'
+            changed_core = []
+            count = 0
+            for name in names:
+                prefix = 'mcarplay-project/app/src/main/java/com/mcarplay/app/'
+                if not name.startswith(prefix) or not name.endswith(('.kt', '.java')):
+                    continue
+                rel = name[len(prefix):]
+                if rel.split('/')[0] in {'ui', 'legal'} or rel == 'MainActivity.kt':
+                    continue
+                count += 1
+                if (java / rel).read_bytes() != archive.read(name):
+                    changed_core.append(rel)
+            assert not changed_core, changed_core
+            print(f'All original layout IDs preserved ({len(layouts)} layouts); {count} non-UI main Kotlin/Java files byte-identical')
+    print('PASS: static UI structure and contrast only')
+
+
+if __name__ == '__main__':
+    main()
