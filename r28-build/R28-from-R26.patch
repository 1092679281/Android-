+package com.mcarplay.app.ui.kit
+
+import android.animation.ValueAnimator
+import android.transition.AutoTransition
+import android.transition.TransitionManager
+import android.view.View
+import android.view.ViewGroup
+import android.view.animation.PathInterpolator
+
+/** UI-only transitions; never defer a session action until an animation completes. */
+object UiMotion {
+    private fun ease() = PathInterpolator(0.22f, 0.85f, 0.25f, 1f)
+
+    fun reveal(
+        view: View,
+        distanceDp: Int = 8,
+    ) {
+        view.animate().cancel()
+        view.alpha = 1f
+        view.translationY = 0f
+        if (!ValueAnimator.areAnimatorsEnabled() || !view.isShown) return
+        view.alpha = 0.65f
+        view.translationY = view.context.dp(distanceDp).toFloat()
+        view.animate().alpha(1f).translationY(0f).setInterpolator(ease()).setDuration(240L).start()
+    }
+
+    fun rotate(
+        view: View,
+        expanded: Boolean,
+    ) {
+        view.animate().cancel()
+        val target = if (expanded) 180f else 0f
+        if (!ValueAnimator.areAnimatorsEnabled()) {
+            view.rotation = target
+            return
+        }
+        view.animate().rotation(target).setInterpolator(ease()).setDuration(260L).start()
+    }
+
+    fun expand(
+        body: View,
+        chevron: View,
+        expanded: Boolean,
+    ) {
+        val visibility = if (expanded) View.VISIBLE else View.GONE
+        val parent = body.parent as? ViewGroup
+        if (parent != null) {
+            // A scoped transition, not a persistent LayoutTransition reacting to every status refresh.
+            TransitionManager.endTransitions(parent)
+            if (body.visibility != visibility && parent.isShown && parent.isLaidOut && ValueAnimator.areAnimatorsEnabled()) {
+                TransitionManager.beginDelayedTransition(
+                    parent,
+                    AutoTransition().apply {
+                        setDuration(180L)
+                        setInterpolator(ease())
+                    },
+                )
+            }
+        }
+        body.visibility = visibility
+        rotate(chevron, expanded)
+    }
+}
